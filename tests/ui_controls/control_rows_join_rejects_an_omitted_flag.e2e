# control: fail expect_ui_rows_join 10
# FAILURE CONTROL -- this script must FAIL. The join text is the journaled
# input minus one flag ("--skip-reconcile-check "): the rows carry it, the
# text does not, so the join has extra characters and must be refused. If it
# passes, an omission in the expectation is being blessed.
# settings: {"window_width":340,"window_height":620,"open_tabs":["t2"],"active_tab":"t2","theme":"dark"}
# env: HANABI_ASK_DEMO=longapproval HANABI_WIN_W=340 HANABI_WIN_H=620
require_thread t2
expect_text "The agent needs approval  ·  bash"
expect_ui_rows_join ask_approval_input '{"command":"./scripts/release_batch.sh --force --cycle=2026-09 --ledger=/var/finance/payouts/2026-09/ledger.csv --out=/var/finance/payouts/2026-09/settled.csv --notify=payout-owner@example.test --allow-outside-workspace"}'
