# Close others preserves both pinned pane threads, and closing an unrelated tab leaves them distinct.
# settings: {"window_width":1100,"window_height":760,"open_tabs":["t1","t2","t4","t5"],"active_tab":"t4","pinned_tabs":["t1","t2"],"split_open":true,"split_ratio":0.5,"split_panes":["t1","t2"],"split_focused_pane":1,"theme":"dark"}

require_thread t1
require_thread t2

# Named targets, not pixels: the strip's geometry has moved since this was
# written, and a coordinate lands on whichever tab sits there now.
right_click_ui tab_t4
wait_frames 3
click_ui tab_menu_close_others
wait_frames 20
# Close Others closes only unpinned tabs and, as the reference does, leaves a
# surviving active tab where it is: both pinned pane threads are still up.
expect_tab t5 absent within=30
require_thread t1
require_thread t2
expect_panes t1 t2 1

assert_ui split_divider hidden=false
assert_ui split_focus_edge x=693

# Close the focused pane's pinned t2. A kept tab refuses an ordinary close
# (its pin lights instead), so it goes the way the reference closes one on
# purpose, Close Kept Tab (Cmd Shift W); the pane lands on the next survivor.
hover_ui tab_active
wait_frames 4
hover_ui tab_close
wait_frames 2
expect_text "Close tab: needs a decision before it can go on"
key CMD+SHIFT+W
wait_frames 8
require_thread t4
expect_panes t1 t4 1

assert_ui tab_t1 hidden=false
assert_ui tab_active hidden=false
expect_text "Tab: stickers broke — concluded, D113637134 on you, pinned"
expect_text "Tab: finished, and wants you to read it, active"
expect_no_text "Tab: needs a decision before it can go on"
