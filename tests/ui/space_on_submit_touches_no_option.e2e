# settings: {"window_width":1100,"window_height":760,"open_tabs":["t2"],"active_tab":"t2","theme":"dark"}
# env: HANABI_ASK_DEMO=1 HANABI_ASK_FAIL=echo

require_thread t2
expect_text "The agent is asking"
expect_text "Answer any one of these to submit"

focus_ui ask_option_q1_0
expect_focused ask_option_q1_0
key SPACE
wait_frames 8
expect_no_text "Answer any one of these to submit"

focus_ui ask_submit
expect_focused ask_submit
key SPACE
wait_frames 12
expect_no_text "Answer any one of these to submit"
expect_text "The agent is asking"
expect_no_text "accept — press Submit to try again."

key SPACE
wait_frames 12
expect_no_text "Answer any one of these to submit"
expect_text "The agent is asking"
expect_no_text "accept — press Submit to try again."

key ENTER
wait_frames 25
expect_text "accept — press Submit to try again."
