# A tab belongs to a pane, and clicking it shows it THERE -- in the pane whose
# strip it sits in -- leaving the other pane alone.
#
# Each pane has its own strip over its own tabs (Puffin's tab groups), and a
# thread is in one pane at a time: splitting MOVES the focused tab into a new
# pane to the right. So "which pane did the click change" is a fact about the
# tab, and expect_groups asserts it directly: the tabs of each pane, which
# pane has the keyboard, and what each pane shows.
#
# settings: {"window_width":1100,"window_height":760,"open_tabs":["t2","t9","t1"],"active_tab":"t2","theme":"dark"}

require_thread t2

# One pane on t2, with t9 and t1 beside it in the strip.
assert_ui transcript_scroll hidden=false
expect_groups "t2,t9,t1" 0 "t2"
expect_text "Reconcile this cycle's Stars payouts against the ledger"
expect_no_text "Recurring: kick the pending queue every ten minutes."

# Split. t2 moves to a pane of its own on the right and takes the keyboard;
# t9 and t1 stay on the left, where t9 is what the left pane shows.
key CTRL+BACKSLASH
wait_frames 30
assert_ui split_right hidden=false
assert_ui split_focus_edge x=693
expect_groups "t9,t1|t2" 1 "t9,t2"
require_thread t9
expect_text "Recurring: kick the pending queue every ten minutes."
expect_text "Reconcile this cycle's Stars payouts against the ledger"

# Click t1 in the LEFT strip while the keyboard is in the right pane: the left
# pane changes to t1 and takes the keyboard; the right pane is still t2.
click_ui tab_t1
wait_frames 30
expect_groups "t9,t1|t2" 0 "t1,t2"
assert_ui split_focus_edge x=280
expect_text "Reconcile this cycle's Stars payouts against the ledger"

# The other direction, so this is a rule and not an accident of which pane is
# which: put the keyboard back in the right pane, click t9 in the left strip,
# and it is the left pane that changed again.
click 900 400
wait_frames 10
assert_ui split_focus_edge x=693
click_ui tab_t9
wait_frames 30
expect_groups "t9,t1|t2" 0 "t9,t2"
require_thread t9

# Close the split: every tab comes back to one strip and the pane that had the
# keyboard keeps its tab.
key CTRL+BACKSLASH
wait_frames 30
expect_groups "t9,t1,t2" 0 "t9"
assert_ui transcript_scroll w=820
