assert_ui settings_reasoning_label_line w=440
assert_ui settings_reasoning_row w=440

expect_text "Reasoning blocks"
expect_text "This Mac"
expect_text "Your account"

resize 1100 760
wait_frames 10
assert_ui settings_reasoning_label_line w=634
assert_ui settings_reasoning_row w=634
