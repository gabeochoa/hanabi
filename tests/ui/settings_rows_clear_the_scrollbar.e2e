# settings: {"window_width":760,"window_height":620,"open_tabs":[],"active_tab":"","theme":"dark","settings_pane":"chat"}
# env: HANABI_TEST_OVERLAY=settings

resize 760 620
wait_frames 10

assert_ui settings_panel w=712
assert_ui settings_body w=664
assert_ui settings_pane_scroll w=478
