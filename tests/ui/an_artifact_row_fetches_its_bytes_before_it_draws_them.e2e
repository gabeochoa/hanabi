# A shown artifact arrives as coordinates, not bytes. The row names the file
# at once; the image and the player appear only after the bytes have been
# fetched from the backend into the cache.
#
# settings: {"window_width":1100,"window_height":760,"open_tabs":[],"active_tab":"","theme":"dark"}
# env: HANABI_ARTIFACT_DEMO=fetch HANABI_OPEN=t1

require_thread t1

expect_text "price-tiers.png"
expect_text "approval-note.wav"
wait_frames 30
assert_ui artifact_image hidden=false
# The audio clip is fetched too and plays from its row (kt-nmbp).
expect_text_drawn "0:00 / 0:02" within=60
assert_ui artifact_audio_play hidden=false
expect_no_ui artifact_clip
