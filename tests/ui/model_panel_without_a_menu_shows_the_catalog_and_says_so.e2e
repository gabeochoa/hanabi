# A backend that serves no `models` menu: the panel shows the catalog hanabi
# knows and SAYS the server was not asked, rather than an empty list; the
# rows still act (the server's own refusal is the only gate).
#
# settings: {"window_width":1100,"window_height":760,"open_tabs":["t2"],"active_tab":"t2","theme":"dark"}
# env: HANABI_OPEN=t2 HANABI_MOCK_NO_MODEL_MENU=1
require_thread t2
wait_frames 12
click_ui composer_model
wait_frames 12
assert_ui model_popover_title hidden=false
assert_ui model_popover_menu_note hidden=false
expect_text "This backend serves no model menu; showing the catalog."
assert_ui model_row_gpt-5.5 hidden=false
click_ui model_row_claude-sonnet-5
wait_frames 14
expect_backend_tuning t2 claude-sonnet-5 -
