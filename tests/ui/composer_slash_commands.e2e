# Typing "/" in the composer raises the command menu, and a slash command is
# carried out by the client instead of being sent to the agent as text.
#
# The rows are asserted by their blurbs, not by the verb: "/model" is also what
# the field itself holds, so asserting the word would pass on the typed text
# alone with no menu on screen at all.
#
# The script never clicks the field twice in quick succession. Two clicks a few
# frames apart are a DOUBLE click when the frames are fast, and that window is
# real time — the first version of this test re-clicked to select the draft and
# retype it, which passed only while the machine was loaded and failed on an
# idle one. So the draft is grown by typing onto what is already there, and the
# one place it has to be emptied uses the app's own Esc-to-clear. (select_all
# WOULD do it now -- the harness spells it CTRL+A and TextSelectAll is bound to
# Ctrl as well as Cmd, gap #256 -- but Esc-to-clear is the app's own path and
# the one worth exercising here.)
#
# settings: {"window_width":1100,"window_height":760,"open_tabs":["t2"],"active_tab":"t2","theme":"dark"}

require_thread t2

expect_text "needs a decision"

click_ui composer_reply_input
wait_frames 4

# A bare slash offers the whole vocabulary.
type "/"
wait_frames 8
expect_text "start a new conversation"
expect_text "compact the context now"

# Typing on narrows it to one command.
type "mod"
wait_frames 8
expect_text "choose the default model"
expect_no_text "compact the context now"

# Choosing /model opens the real picker instead of leaving an inert command in
# the field.
click_ui slash_item_0
wait_frames 8
expect_text "Server default"
expect_text "Opus 5"
click_ui model_row_1
wait_frames 8
expect_text "Opus 5"
expect_input_text composer_reply_input ""

click_ui composer_reply_input
wait_frames 4
type "/eff"
wait_frames 8
expect_text "choose the thinking effort"
click_ui slash_item_0
wait_frames 8
expect_text "Thinking effort"
expect_text "middle of the ladder"
click_ui effort_row_0
wait_frames 8
expect_text "(Low)"
expect_input_text composer_reply_input ""

# /new raises the new-conversation sheet.
click_ui composer_reply_input
wait_frames 4
type "/new"
wait_frames 8
key ENTER
wait_frames 20
expect_text "Describe the task"
