# Esc dismisses the topmost thing, and only that.
#
# Four sites polled Esc independently — the find bar, the transcript selection,
# the composer field, and each overlay — and afterhours' injector hands one
# press to all of them. So closing the find bar also wiped the reply you had
# typed. One owner resolves the key now (src/ecs/escape_system.h) and the sites
# read the resolved intent.
#
# The find bar is opened through the state knob because the harness cannot
# press a Cmd chord (afterhours_gaps.md #49).
#
# settings: {"window_width":1100,"window_height":760,"open_tabs":["t2"],"active_tab":"t2","theme":"dark"}
# env: HANABI_FIND_DEMO=ledger

require_thread t2

expect_text "1 of 3"

# Focus the composer BY NAME. This was `click 646 674` — a literal point four
# pixels inside the field's top edge — and feat/vis-statusmove moved the whole
# composer 26px down (hanabi reserved a status strip at the window's floor that
# Puffin has no equivalent of; layout_system.h). The point then landed on the
# transcript, the typing went nowhere, and six scripts in this directory failed
# on one edit. `click_ui` takes the widget's centre, so it cannot break on
# layout again.
click_ui composer_reply_input
wait_frames 4
type "draft that must survive"
wait_frames 4
expect_text "draft that must survive"

key ESCAPE
wait_frames 8

# The find bar is gone.
expect_no_text "1 of 3"
# The draft it used to take with it is still here.
expect_text "draft that must survive"

# With nothing over it, Esc belongs to the composer again — and the caret is
# still in the field, because closing the bar hands focus back.
key ESCAPE
wait_frames 8
expect_no_text "draft that must survive"
