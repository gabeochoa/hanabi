# The menu acts on the tab it was opened on, by its captured session id:
# with a split open and the RIGHT pane focused on t2, muting from t1's tab
# menu mutes t1 -- never the focused pane's thread -- and the right pane's
# thread, text and focus are untouched.
# settings: {"window_width":1100,"window_height":760,"open_tabs":["t1","t2"],"active_tab":"t2","split_open":true,"split_ratio":0.5,"split_panes":["t1","t2"],"split_focused_pane":1,"theme":"dark"}
# env: HANABI_OPEN=t1 HANABI_SPLIT=t2
require_thread t1
require_thread t2
expect_panes t1 t2 1
click_ui composer_reply_input
expect_focused composer_reply_input
right_click_ui tab_t1
wait_frames 8
expect_text "Mute"
click_ui tab_menu_mute
expect_text_drawn "Session muted" within=60
expect_panes t1 t2 1
right_click_ui tab_t1
wait_frames 8
expect_text "Unmute"
key ESCAPE
wait_frames 6
right_click_ui tab_t2
wait_frames 8
expect_text "Mute"
expect_no_text "Unmute"
key ESCAPE
