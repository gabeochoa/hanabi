# settings: {"window_width":1100,"window_height":760,"open_tabs":[],"active_tab":"","theme":"dark"}
require_thread t2
wait_frames 10
click_ui composer_reply_input
type "/draft"
wait_frames 4
key ESCAPE
wait_frames 4
key ENTER
wait_frames 10
expect_text "No saved drafts yet"
type "/draft standup what moved since yesterday, and what is stuck"
key ENTER
wait_frames 10
expect_text "Saved /standup"
expect_input_text composer_reply_input ""
type "/draft"
wait_frames 4
key ESCAPE
wait_frames 4
key ENTER
wait_frames 10
expect_text "Saved drafts: /standup"
type "/standup"
wait_frames 4
key ESCAPE
wait_frames 4
key ENTER
wait_frames 10
expect_input_text composer_reply_input "what moved since yesterday, and what is stuck"
