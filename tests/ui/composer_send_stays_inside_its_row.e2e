# The send control keeps one footprint while its state changes.
# (Pinned to the Comfortable column: the coordinates below are worked from
# its 768. Fit to pane, the default, is a_fit_to_pane_column_grows_with_the_pane.e2e.)
# settings: {"window_width":1100,"window_height":760,"open_tabs":["r9"],"active_tab":"r9","theme":"dark","transcript_width_choice":"comfortable"}
# env: HANABI_WIN_W=1100 HANABI_WIN_H=760 HANABI_THINK_DEMO=1

require_thread r9
wait_frames 12
assert_ui composer_row x=280 w=820
assert_ui composer_send x=1034 w=28 h=28
assert_ui composer_input_wrap w=707
