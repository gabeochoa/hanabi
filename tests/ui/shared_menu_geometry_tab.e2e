# settings: {"window_width":1100,"window_height":760,"open_tabs":["t2","t6"],"active_tab":"t2","theme":"dark"}
# env: HANABI_OPEN=t2 HANABI_TEST_OVERLAY=tab-menu

require_thread t2
# No caption row (the reference's tab menu has none): thirteen 36 px rows
# and four 9 px hairlines inside 4 px of padding. The Halt group (Halt, Halt
# with 2 Sub-agents) appears because t2 is ATTACHED in this fixture and the
# mock serves halt_v1; Copy Deeplink beside Copy Weblink; Export to Clipboard
# in its own group; Archive and Archive and Close Tab in theirs.
# 4 + 18*36 + 6*9 + 4 = 683.
expect_no_text "TAB ACTIONS"
expect_no_ui tab_menu_title
assert_ui tab_menu w=184 h=683
assert_ui tab_menu_eater w=1100 h=760
assert_ui tab_menu_close w=176 h=36
assert_ui tab_menu_close_others w=176 h=36
assert_ui tab_menu_close_right w=176 h=36
assert_ui tab_menu_divider w=176 h=9
assert_ui tab_menu_divider_rename w=176 h=9
assert_ui tab_menu_divider_copy w=176 h=9
assert_ui tab_menu_divider_pin w=176 h=9
assert_ui tab_menu_rename w=176 h=36
assert_ui tab_menu_copy_title w=176 h=36
assert_ui tab_menu_copy_weblink w=176 h=36
assert_ui tab_menu_copy_deeplink w=176 h=36
assert_ui tab_menu_copy_id w=176 h=36
assert_ui tab_menu_open_web w=176 h=36
assert_ui tab_menu_export_clipboard w=176 h=36
assert_ui tab_menu_divider_export w=176 h=9
assert_ui tab_menu_halt w=176 h=36
assert_ui tab_menu_halt_subtree w=176 h=36
assert_ui tab_menu_divider_halt w=176 h=9
assert_ui tab_menu_pin w=176 h=36
assert_ui tab_menu_mute w=176 h=36
assert_ui tab_menu_archive w=176 h=36
assert_ui tab_menu_archive_close w=176 h=36
assert_ui tab_menu_divider_archive w=176 h=9
assert_ui tab_menu_split w=176 h=36
# Not on the reference's tab menu: gone from hanabi's.
expect_no_ui tab_menu_close_all
expect_no_ui tab_menu_fork
