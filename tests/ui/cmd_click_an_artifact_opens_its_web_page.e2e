# Cmd+click an artifact row opens the artifact on the web app's own page for
# it -- the session with the artifact docked beside its transcript, at the
# row's version (Puffin 0.8.9; the reference's `?dock=artifact:<id>:<v>`). A
# plain click opens nothing on the web.
#
# settings: {"window_width":1100,"window_height":760,"open_tabs":[],"active_tab":"","theme":"dark"}
# env: HANABI_ARTIFACT_DEMO=1 HANABI_OPEN=t1 HANABI_WEB_BASE_URL=https://web.example.test/chat

require_thread t1
expect_text "price-tiers.png"

reset_link_opened
click_ui artifact_head
wait_frames 6
expect_link_opened ""

hold_modifier ctrl
click_ui artifact_head
wait_frames 6
release_modifier ctrl
expect_link_opened "https://web.example.test/chat/t1?dock=artifact:art-chart:v1"
