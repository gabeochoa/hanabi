# Turning timestamps off takes the time off the transcript rows, and leaves
# the rows themselves alone.
#
# The stamp rides INSIDE the caption's own label ("…proration.   ·   4h"), so
# the assertion is the whole phrase: a bare "4h" is also every sidebar row's
# age and would pass whatever this setting did. The second assertion is the
# other half — the caption is still there, so the row was re-rendered without
# its time rather than dropped.
#
# The thread is t4 and not t2: t2's opening System caption became a user turn
# so the parity capture opens on the shape Puffin's does, and this script needs
# a thread that still has one.
#
# Driven through the real Settings sheet (the gear, not a state knob): the
# preference is only worth having if the control writes it.
#
# env: HANABI_MOCK_NOW=0
#
# Opts out of the runner's pinned fixture clock, for the same reason
# transcript_date_dividers.e2e does: "4h" is a duration since now, and the pin
# puts the fixture at a fixed instant in the past so that a date divider
# cannot move a coordinate test 26px (scripts/run_ui_tests.sh). mock_client.h
# treats 0 as unset.
# settings: {"window_width":1100,"window_height":760,"open_tabs":["t4"],"active_tab":"t4","theme":"dark"}

require_thread t4

expect_text "proration.   ·   4h"

click_ui sb_settings
wait_frames 8
expect_text "Timestamps"
click_ui settings_timestamps_0
wait_frames 8
click_ui settings_close
wait_frames 10

expect_no_text "proration.   ·   4h"
expect_text "proration."
