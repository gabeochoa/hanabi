# Clicking a sidebar row opens that thread in a tab and swaps the transcript.
#
# settings: {"window_width":1100,"window_height":760,"open_tabs":[],"active_tab":"","theme":"dark"}

# Home, nothing open. The row's TITLE is already in the sidebar, so assert on
# transcript content instead — otherwise the check passes without a click.

expect_text "Home"
expect_no_text 2.1M

# "SKU backfill — my name for it" is the sixth row of the activity list, whose
# band is y=460..492 at this window size; "61% through 2.1M rows" is a line of
# ITS transcript and of no other.
click 120 475
wait_frames 8
expect_text "61% through 2.1M rows"

# The composer switches from kickoff to reply once a thread is open.
expect_no_text Start
