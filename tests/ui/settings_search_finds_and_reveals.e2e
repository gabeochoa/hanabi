# settings: {"window_width":1100,"window_height":760,"open_tabs":[],"active_tab":"","theme":"dark"}

click_ui sb_settings
wait_frames 8

type "them"
wait_frames 8
assert_ui settings_result_0 w=174
expect_text "Theme"
expect_text "Rotate theme"
expect_text "Theme"

click_ui settings_result_0
wait_frames 8
# The pane has no subtitle now (the reference's pane opens with its content); its
# first section title says which pane is up.
expect_text "Reading width"
expect_text "Rotate theme"
expect_no_text "Send message with"

click_ui settings_search
wait_frames 6
type "dnd"
wait_frames 8
expect_text "Quiet hours"
expect_text "Notifications"

# The field keeps the caret while it has it, so DOWN walks the results and
# ENTER opens the one that is lit.
click_ui settings_search
wait_frames 4
key DOWN
wait_frames 6
key ENTER
wait_frames 12
# (the pane has no subtitle now; its first row says which pane is up)
expect_text "Show notifications"
expect_text "Quiet hours"
expect_no_text "Rotate theme"

click_ui settings_search
wait_frames 6
type "zzzqq"
wait_frames 8
expect_text "No settings match"
expect_text "zzzqq"

key ESCAPE
wait_frames 8
expect_no_text "No settings match"
# (the pane has no subtitle now; its first row says which pane is up)
expect_text "Show notifications"

# A second Escape does NOT close Settings: it is a tab, and tabs close by
# their x. The pane stays; the chip's close takes it away.
key ESCAPE
wait_frames 8
# (the pane has no subtitle now; its first row says which pane is up)
expect_text "Show notifications"
click_ui tab_close
wait_frames 12
expect_no_text "When this Mac may interrupt you, and when it may not"
