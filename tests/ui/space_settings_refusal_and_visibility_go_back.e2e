# Space settings: a write Metamate refuses is shown in the server's words, and
# the visibility control goes back to what the server holds -- not left on the
# refused value.
#
# settings: {"window_width":1100,"window_height":760,"open_tabs":[],"active_tab":"","theme":"dark"}
# env: HANABI_MOCK_SPACE_FILING=t9:1593993452358360 HANABI_MOCK_SPACE_DENY=1

wait_frames 30
right_click_text "SUBS"
wait_frames 6
click_ui space_menu_settings
wait_frames 20
click_ui space_settings_vis_PUBLIC
wait_frames 20
expect_text "Only admins of this Space can change it (permission denied)"
assert_ui space_settings_vis_PRIVATE hidden=false
expect_mock_space_write_none
