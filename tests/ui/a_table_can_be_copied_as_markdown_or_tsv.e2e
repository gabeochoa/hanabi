# settings: {"window_width":1100,"window_height":760,"open_tabs":[],"active_tab":"","theme":"dark"}
# env: HANABI_MD_DEMO=1 HANABI_OPEN=rmd
require_thread rmd
wait_frames 20
reset_clipboard_probe
right_click_ui md_table
wait_frames 6
expect_text "Copy Table as Markdown"
click_text "Copy Table as TSV"
wait_frames 6
expect_clipboard_contains "Check	Count	Status"
expect_clipboard_contains "call sites	3	open"
reset_clipboard_probe
right_click_ui md_table
wait_frames 6
click_text "Copy Table as Markdown"
wait_frames 6
expect_clipboard_contains "| Check | Count | Status |"
expect_clipboard_contains "| --- | --- | --- |"
right_click_text "#42 is the follow-up ticket."
wait_frames 6
expect_no_text "Copy Table as Markdown"
key ESCAPE
