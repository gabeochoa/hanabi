# Tab really walks the ask card, one PAGE at a time.
#
# This used to walk all four questions of the `big` form down one tall card
# and assert the viewport dragged after the ring (744px of content in a 335px
# body). A form with several questions now pages one question at a time
# (the reference's 0.8.1 / 0.8.6), so the ring is the page's: its options in order, its
# free-text field, then the actions -- the primary button, which ADVANCES on
# every question but the last ("Next"), and Decline. Every move below is an
# injected Tab through the input path the shipping build reads.
#
# The free-text field is asserted by ARITHMETIC rather than by name: every
# one of them is a `text_input_field`. Two stops from q1_3 to Next is the
# field and then the button.
#
# settings: {"window_width":760,"window_height":620,"open_tabs":["t2"],"active_tab":"t2","theme":"dark"}
# env: HANABI_ASK_DEMO=big

require_thread t2
disable_animations
expect_text "Four accounts disagree with the ledger"

# Page one is the first question only; the rest are tabs.
expect_no_text "What may I touch while fixing it?"
expect_no_text "nobody, it is already approved in the ticket"

focus_ui ask_option_q1_0
expect_focused ask_option_q1_0
key TAB
wait_frames 6
expect_focused ask_option_q1_1
key TAB
wait_frames 6
expect_focused ask_option_q1_2
key TAB
wait_frames 6
expect_focused ask_option_q1_3
key TAB
wait_frames 6
key TAB
wait_frames 6
expect_focused ask_page_next
key TAB
wait_frames 6
expect_focused ask_decline

# Backwards lands on the neighbour.
shift_tab
wait_frames 6
expect_focused ask_page_next

# Next turns the page and keeps the caret on the card: the new page's
# primary button.
key ENTER
wait_frames 16
expect_text "What may I touch while fixing it?"
expect_focused ask_page_next

# The last question's page has the last question's rows on screen, and its
# primary is Submit.
click_ui ask_tab_q4
wait_frames 12
expect_text "nobody, it is already approved in the ticket"
expect_no_ui ask_page_next
assert_ui ask_submit hidden=false
