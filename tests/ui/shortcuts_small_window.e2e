# settings: {"window_width":800,"window_height":360,"open_tabs":[],"active_tab":"","theme":"dark"}
# env: HANABI_TEST_OVERLAY=shortcuts-recording

resize 800 360
wait_frames 6
assert_ui shortcuts_panel y=24 h=312
assert_ui shortcuts_cols h=220
expect_text "Keyboard shortcuts"
expect_text "Press a shortcut with Command. Escape cancels."

key ESCAPE
wait_frames 8
expect_no_text "Press a shortcut with Command. Escape cancels."
expect_text "Recording cancelled."
expect_text "Keyboard shortcuts"

key ESCAPE
wait_frames 8
expect_no_text "Keyboard shortcuts"
