# The keyboard reference lists the app's bindings, and Esc closes it.
#
# Its own binding is Cmd+/ and the harness cannot press that: parse_key_combo
# maps CMD+ to Control, and the Super flag it does parse is never held
# (afterhours_gaps.md #49). So the sheet is opened through the same knob the
# screenshot harness uses, and the Esc path is what gets driven here.
#
# settings: {"window_width":1100,"window_height":760,"open_tabs":[],"active_tab":"","theme":"dark"}
# env: HANABI_TEST_OVERLAY=shortcuts

expect_text "Keyboard shortcuts"
expect_text "Show or hide the sidebar"
expect_text "Bring the app forward and start a task"
expect_text "Copy the selected text"
expect_text "Jump to the start or the newest"
# The editing chords. A binding that is not on this sheet is a binding nobody
# can find, so each one added to the key table is added here too.
expect_text "Delete the word before"
expect_text "Start or end of the line"
expect_text "Delete back to the line start"
expect_text "Select everything in the field"

key ESCAPE
wait_frames 8
# A whole phrase, not the bare word "Keyboard": expect_no_text was left out
# of the quoted-argument chain upstream, so it used to compare against the
# literal `"Keyboard shortcuts"` INCLUDING the quotes and could never fail.
# Fixed in afterhours 2d6f23d.
expect_no_text "Keyboard shortcuts"
