# Control-Command-Right moves the READER to the next pane and
# Control-Command-Left brings it back (the reference's Window > Focus Next /
# Previous Pane, kt-23cm): the same arrows as the tab chords one modifier
# apart, because it is the same question one level up. At an end the chord
# does nothing rather than wrapping.
# settings: {"window_width":1100,"window_height":760,"open_tabs":["t2","t6"],"active_tab":"t2","split_open":true,"split_ratio":0.5,"split_panes":["t2","t6"],"split_focused_pane":0,"theme":"dark"}
# env: HANABI_SPLIT=t6
expect_panes t2 t6 0
key CMD+CTRL+LEFT
wait_frames 4
expect_panes t2 t6 0
key CMD+CTRL+RIGHT
wait_frames 4
expect_panes t2 t6 1
key CMD+CTRL+RIGHT
wait_frames 4
expect_panes t2 t6 1
key CMD+CTRL+LEFT
wait_frames 4
expect_panes t2 t6 0
