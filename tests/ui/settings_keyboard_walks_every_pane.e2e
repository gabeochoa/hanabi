# settings: {"window_width":1100,"window_height":760,"open_tabs":[],"active_tab":"","theme":"dark"}

click_ui sb_settings
wait_frames 8
expect_text "Send message with"

type "dark"
wait_frames 8
expect_text "Palette"
expect_text "Appearance"

key ESCAPE
wait_frames 8
expect_text "Send message with"
# (the pane has no subtitle now; its first row says which pane is up)
expect_text "Send message with"

key TAB
wait_frames 6
key DOWN
wait_frames 4
# Appearance's first row (the pane's tail may sit below the fold now that
# Context and Composer rows precede Typeface).
expect_text "Transcript width"
key DOWN
wait_frames 4
expect_text "Reasoning blocks"
key DOWN
wait_frames 4
expect_text "Show notifications"
key DOWN
wait_frames 4
expect_text "Keep at most on disk"
expect_no_text "Reasoning blocks"

key UP
wait_frames 4
expect_text "Show notifications"

key DOWN
key DOWN
key DOWN
key DOWN
wait_frames 6
# (the pane has no subtitle now; its first row says which pane is up)
expect_text "Keyboard shortcuts"
expect_text "Start a task from anywhere"

key DOWN
wait_frames 4
# (the pane has no subtitle now; its first row says which pane is up)
expect_text "Slash commands"

key DOWN
wait_frames 4
# (the pane has no subtitle now; About's footnote carries the version)
expect_text "hanabi 0.1.0"

key DOWN
wait_frames 4
# (the pane has no subtitle now; About's footnote carries the version)
expect_text "hanabi 0.1.0"

# Escape no longer closes Settings: it is a TAB, and a tab closes by its x
# (the reference's behaviour -- Escape there clears the search and drops
# focus). The pane is still up afterwards; closing is the chip's job.
key ESCAPE
wait_frames 8
# (the pane has no subtitle now; About's footnote carries the version)
expect_text "hanabi 0.1.0"
click_ui tab_close
wait_frames 12
expect_no_text "Version, and what this build carries"
