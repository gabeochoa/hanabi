# Closing the last tab drops back to Home and clears the transcript.
#
# settings: {"window_width":1100,"window_height":760,"open_tabs":["t2"],"active_tab":"t2","theme":"dark"}

expect_text "Reconciled 4,812 accounts"

# The × only exists while the tab is hovered, so the cursor has to arrive
# before the press. The tab occupies x=284..503, y=32..65; its × is the 16px
# square 5px in from its right edge.
mouse_move 491 49
wait_frames 2
click 491 49
wait_frames 8

expect_text "Home"
expect_no_text Reconciled
