# Drag a sidebar row into a new place in its folder.
#
# The list is sorted by ACTIVITY, so a manual order is not a re-sort — it is a
# pinned prefix. This script says that out loud in three steps: the folder has
# no manual order to begin with (its row menu offers nothing to reset), a drag
# puts a row at the top and the rows it passed shuffle down one slot, and
# resetting the order puts the activity list back.
#
# Positions are the assertion, because "the row moved" is a claim about order
# and nothing else can carry it: the rendered band starts at y=382 and every row
# is 24px tall, so slot 0 is y=382 and slot 5 is y=502.
#
# Rows are addressed by coordinate because the harness has no
# `right_click_ui <name>` (afterhours_gaps.md #55) and no way to name one row of
# a list; the menu ITEMS are addressed by name, which is safe once it is open.
#
# settings: {"window_width":1100,"window_height":760,"open_tabs":[],"active_tab":"","theme":"dark"}

# Activity order: most recently touched at the top, and the thread we are about
# to move sitting six rows down.
mouse_move 650 400
wait_frames 10
assert_ui_text "Tidy up the retry backoff in the s…" y=382
assert_ui_text "Draft release notes for 4.2" y=502

# Nothing has been arranged yet, so there is no order to reset.
right_click 120 386
wait_frames 4
expect_text "Archive"
expect_no_text "Reset order"
click 650 300
wait_frames 4

# Press the sixth row and carry it to the top. The drop line is what says the
# app has understood this as a drag rather than a click.
mouse_down 140 511
wait_frames 2
mouse_move 140 470
wait_frames 2
mouse_move 140 420
wait_frames 2
mouse_move 140 386
wait_frames 3
assert_ui row_drop_line hidden=false
mouse_up
wait_frames 8

# It landed, the row it displaced is one slot lower, and it stays put with the
# pointer off the sidebar entirely. The thread was never opened on the way past:
# a press that becomes a drag is not a click.
mouse_move 650 400
wait_frames 8
assert_ui_text "Draft release notes for 4.2" y=382
assert_ui_text "Tidy up the retry backoff in the s…" y=406
expect_no_text "Pulled the 62 landed changes"

# The folder now reads as hand-arranged, and saying so undoes it.
right_click 120 386
wait_frames 4
expect_text "Reset order"
click_ui row_menu_reset_order
wait_frames 8
mouse_move 650 400
wait_frames 6
assert_ui_text "Tidy up the retry backoff in the s…" y=382
assert_ui_text "Draft release notes for 4.2" y=502
