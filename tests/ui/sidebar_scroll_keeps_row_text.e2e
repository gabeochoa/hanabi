# Regression: scrolling the sidebar list used to leave the rows in place but
# stop drawing their titles past a certain offset — the rows stayed clickable
# and went blank.
#
# The list caps itself at roughly a viewport's worth of rows and offers the
# rest behind "Show N more…", so there is nothing to scroll PAST until that is
# opened. Opening it is therefore step one, not incidental setup.
#
# settings: {"window_width":1100,"window_height":760,"open_tabs":[],"active_tab":"","theme":"dark"}

expect_text "profiling the disk"

click_ui sb_show_more
wait_frames 8

mouse_move 140 600
scroll_wheel 0 -6
wait_frames 6
scroll_wheel 0 -6
wait_frames 6

# Whatever is under the cursor now, SOMETHING must still be lettered: this row
# is the last in the list and is only on screen after the scroll.
expect_text "PSC daily post generator"
