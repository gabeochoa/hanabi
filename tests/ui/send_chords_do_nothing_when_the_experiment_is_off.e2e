# settings: {"window_width":1100,"window_height":760,"open_tabs":["t1"],"active_tab":"t1","theme":"dark"}
# env: HANABI_OPEN=t1 HANABI_MOCK_STREAM_HOLD=1
require_thread t1
wait_frames 10
click_ui composer_reply_input
type "first, in flight"
key ENTER
wait_frames 6
type "plain steer"
key CMD+ALT+ENTER
wait_frames 8
expect_no_text "1 queued"
expect_queued t1 none
expect_input_text composer_reply_input ""
