# settings: {"window_width":1100,"window_height":1400,"open_tabs":["rbigtable"],"active_tab":"rbigtable","theme":"dark"}
# env: HANABI_BIG_TABLE_DEMO=1 HANABI_OPEN=rbigtable
require_thread rbigtable
wait_frames 16
expect_text "Every shard:"
assert_ui md_table_more_rows text="11 more rows"
expect_text "shard-50"
expect_no_text "shard-51"
assert_ui md_table_scroll hidden=false
click_ui md_table_more_rows
wait_frames 12
expect_no_ui md_table_more_rows
