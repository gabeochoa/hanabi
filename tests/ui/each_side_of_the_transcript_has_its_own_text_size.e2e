# settings: {"window_width":1180,"window_height":949,"open_tabs":["t2"],"active_tab":"t2","theme":"dark"}
require_thread t2
wait_frames 16
assert_ui_text "Reconcile this cycle's Stars payouts against the ledger before the batch runs." h=16
assert_ui_text "Reconciled 4,812 accounts. 4,810 match to the cent. Two don't:" h=16
click_ui sb_settings
wait_frames 16
type "replies size"
wait_frames 8
expect_text "Replies size"
click_ui settings_result_0
wait_frames 8
click_ui settings_assistant_text_size_2
wait_frames 10
key CMD+W
wait_frames 20
assert_ui_text "Reconcile this cycle's Stars payouts against the ledger before the batch runs." h=16
assert_ui_text "Reconciled 4,812 accounts. 4,810 match to the cent. Two don't:" h=18
click_ui sb_settings
wait_frames 16
type "your messages size"
wait_frames 8
click_ui settings_result_0
wait_frames 8
click_ui settings_user_text_size_0
wait_frames 10
key CMD+W
wait_frames 20
assert_ui_text "Reconcile this cycle's Stars payouts against the ledger before the batch runs." h=14
assert_ui_text "Reconciled 4,812 accounts. 4,810 match to the cent. Two don't:" h=18
