# Undo on the mute toast restores the unmuted state through the same drain;
# a mute left standing is a local setting and is read back on the next
# launch (the fixture opens with t6 already muted: the menu says Unmute).
# settings: {"window_width":1100,"window_height":760,"open_tabs":["t6","t2"],"active_tab":"t2","theme":"dark","muted":["t6"]}
require_thread t2
wait_frames 12
right_click_ui tab_t6
wait_frames 8
expect_text "Unmute"
key ESCAPE
wait_frames 6
right_click_ui tab_t2
wait_frames 8
click_ui tab_menu_mute
expect_text_drawn "Session muted" within=60
click_ui toast_undo
expect_text_drawn "Session unmuted" within=60
right_click_ui tab_t2
wait_frames 8
expect_text "Mute"
expect_no_text "Unmute"
key ESCAPE
