# settings: {"window_width":1100,"window_height":760,"open_tabs":["t2"],"active_tab":"t2","theme":"dark"}
# env: HANABI_MOCK_JOURNAL=/tmp/hanabi-e2e-mock-journal.jsonl
require_thread t2
wait_frames 10
clear_mock_journal
expect_mock_journal -
click_ui composer_reply_input
wait_frames 4
type "journal me"
wait_frames 4
key ENTER
wait_frames 60
expect_backend_message t2 "journal me"
expect_mock_journal "\"session_id\":\"t2\""
expect_mock_journal "\"text\":\"journal me\""
expect_mock_journal "\"kind\":\"hand\""
