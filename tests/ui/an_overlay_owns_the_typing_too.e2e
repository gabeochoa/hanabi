# The overlay here is the SHORTCUTS sheet. It used to be Settings, which is
# a TAB now and covers nothing -- the ask card behind it is not on screen,
# so the premise ("a sheet over a live ask card") needs a sheet that is
# still one.
# settings: {"window_width":1100,"window_height":760,"open_tabs":["t2"],"active_tab":"t2","theme":"dark"}
# env: HANABI_ASK_DEMO=1 HANABI_TEST_OVERLAY=shortcuts

require_thread t2
expect_text "The agent is asking"
expect_text "Keyboard shortcuts"

# One question per page: the field on screen under the sheet is page one's
# free text.
focus_ui ask_other_q1
type "leaked"
wait_frames 12
expect_input_text ask_other_q1 ""

click_ui tab_close
wait_frames 20
expect_no_text "Keyboard shortcuts"
expect_input_text ask_other_q1 ""

type "lands"
wait_frames 4
click_ui ask_tab_q3
wait_frames 6
click_ui ask_text_q3
wait_frames 14
expect_input_text ask_text_q3 "lands"
