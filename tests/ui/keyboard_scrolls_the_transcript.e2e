# A long thread is a document, and a document scrolls from the keyboard.
#
# Home and End jump to the ends; Page moves a viewport less a couple of lines
# so the line you were reading is still on screen. Driven on the 120-message
# perf fixture, the only thread here tall enough to scroll far.
#
# NOTE: expect_no_text takes a BARE single word — see afterhours_gaps.md upstream 2d6f23d.
# "#0:" is that word here: it appears in the first message and no other.
#
# settings: {"window_width":1100,"window_height":760,"open_tabs":[],"active_tab":"","theme":"dark"}
# env: HANABI_BIG_TRANSCRIPT=1 HANABI_OPEN=rbig

# Opens at the bottom, so the first message is far above the viewport and is
# not rendered at all.
require_thread rbig

expect_no_text #0:
# Bottom-pad y values are 22 px lower than they were at afterhours 1ac6db2: at
# d90db15 (a738f48, measure_scroll_content) the scroll view's own padding --
# 12 px above, 10 px below the transcript -- is part of its content size, so
# the bottom padding is finally reachable and the bottom-pinned view rests 22
# px further down. The rows themselves did not move: the first turn after HOME
# is still at y=147, and a wheel notch still moves the view by the same pixels.
assert_ui transcript_bottom_pad y=624

key HOME
wait_frames 10
expect_text "Follow-up question #0:"
# The first turn sits where it always has. (This used to pin the bottom pad's
# absolute y here too; with the viewport-bounded ledger the rows between the
# top and the far-off bottom are estimates until visited, so that number is
# not a promise any more. What IS promised is where the visible row lands.)
assert_ui_text "Follow-up question #0: can you dig into the memory regression and report what you find?" y=147

key END
wait_frames 10
expect_no_text #0:
assert_ui transcript_bottom_pad y=624

# A page back from the end moves, but not all the way to the top.
key PAGE_UP
wait_frames 14
assert_ui transcript_bottom_pad y=1187
expect_no_text #0:
