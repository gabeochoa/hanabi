# Headless: no visible window, so the native phrase prompt cannot execute and
# the submenu ends at its presets -- no divider, no Custom leaf, no dead
# control. The presets themselves still pick.
# settings: {"window_width":1100,"window_height":760,"open_tabs":[],"active_tab":"","theme":"dark"}
expect_text "SKU backfill — my name for it"
mouse_move 120 475
wait_frames 3
right_click 120 475
wait_frames 8
click_ui row_menu_snooze
wait_frames 6
expect_text "In 1 Hour — 1:00 PM"
expect_no_ui row_menu_snooze_custom
expect_no_ui row_menu_snooze_divider
expect_no_text "Custom…"
snooze_prompt_expect idle
key ESCAPE
wait_frames 4
expect_no_text "In 1 Hour"
