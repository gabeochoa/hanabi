# A Home shelf folds shut when you click its heading, and stays folded.
#
# Home stacks four shelves and a busy day makes it a wall: there was no way to
# put one away. The heading is the control now, and the state is written to
# settings so it survives a relaunch.
#
# The chevron is drawn, not typed (the font has no triangles, gap #48), so it
# is invisible to a text assertion — what is asserted here is the cards.
#
# settings: {"window_width":1100,"window_height":760,"open_tabs":[],"active_tab":"","theme":"dark"}

expect_text "Multi-tier pricing rollout"

# The first heading is WAITING ON YOU.
click_ui home_section
wait_frames 8

# Its cards are gone...
expect_no_text "Multi-tier pricing rollout"
# ...and the heading itself stays, so the shelf can be brought back.
expect_text "WAITING ON YOU"

click_ui home_section
wait_frames 8
expect_text "Multi-tier pricing rollout"
