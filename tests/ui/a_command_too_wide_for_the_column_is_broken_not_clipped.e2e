# A command too wide for the column is broken, not clipped.
#
# At 340 the approval column is narrower than a single path argument, so the
# wrapper has to split inside a token. break_long_words=true is what does it;
# without it an over-long word goes on a line of its own and runs off the
# card.
#
# The second half of that sentence went untested for as long as the first was
# passing. The card measured its height with a counter that does NOT break
# long words while drawing with the pass that does, so it reserved 8 rows for
# a command that needs 20 and render_ask_wrapped ellipsised the rest away ---
# the tokens were broken AND the command was clipped, and this script only
# ever looked at the first two rows. It now checks both, and
# a_narrow_approval_shows_every_flag.e2e checks the tail in full.
#
# The offsets below moved when the body started scrolling: an honest extent
# means a scrollbar, a scrollbar costs 10px of column, and a narrower column
# breaks the same token in a different place.
#
# settings: {"window_width":340,"window_height":620,"open_tabs":["t2"],"active_tab":"t2","theme":"dark"}
# env: HANABI_ASK_DEMO=longapproval HANABI_WIN_W=340 HANABI_WIN_H=620

# Break points re-pinned at afterhours 1ac6db2: upstream 82145f9 measures text
# by advance instead of the ink box, so the same column packs one more
# glyph per row (16 rather than 15) and the command is 19 rows, not 20.
# Inspected at 340x620: every row whole, nothing clipped.
require_thread t2
expect_text "The agent needs approval  ·  bash"

# Broken, not clipped, stated as the invariant it is: every character of the
# command is on some row, in order, and no row carries the truncation mark --
# so the join of the rows IS the command. Where a given face breaks a token
# is that face's business (Roboto broke "scripts/release_b|atch.sh"; the
# reference face a glyph later), and the join does not care.
# The rows draw the approval INPUT as journaled -- the command inside its
# JSON object -- so that is the text they must reassemble to.
expect_ui_rows_join ask_approval_input '{"command":"./scripts/release_batch.sh --force --cycle=2026-09 --ledger=/var/finance/payouts/2026-09/ledger.csv --out=/var/finance/payouts/2026-09/settled.csv --notify=payout-owner@example.test --skip-reconcile-check --allow-outside-workspace"}'
# More than one row broke inside a token: the first path argument alone is
# wider than the column, so at least three rows exist before "--force".
assert_ui ask_approval_input_2 hidden=false
expect_no_text "ledger.csv…"

assert_ui ask_submit text=OK
