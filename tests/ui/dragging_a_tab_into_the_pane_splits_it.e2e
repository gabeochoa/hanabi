# A tab dragged DOWN out of the strip and dropped on the right half of the
# pane area opens beside the thread on screen -- the reference's tab-to-split
# drop, the tab menu's "Open in Split" by hand. While it is held over that
# half, the drop zone is tinted so the reader can see where it will land.
# Dropped anywhere else it is an ordinary reorder drag (or nothing).
#
# settings: {"window_width":1100,"window_height":760,"open_tabs":["t2","t6"],"active_tab":"t2","theme":"dark"}

require_thread t2
wait_frames 10
expect_no_ui split_close

mouse_down 560 48
wait_frames 2
mouse_move 600 120
wait_frames 2
mouse_move 900 400
wait_frames 4
assert_ui tab_split_drop_zone hidden=false
mouse_up 900 400
wait_frames 20
expect_no_ui tab_split_drop_zone
assert_ui split_close hidden=false

# Dropped on the LEFT half instead, nothing splits.
click_ui split_close
wait_frames 20
expect_no_ui split_close
mouse_down 560 48
wait_frames 2
mouse_move 520 200
wait_frames 2
mouse_move 400 400
wait_frames 4
expect_no_ui tab_split_drop_zone
mouse_up 400 400
wait_frames 20
expect_no_ui split_close
