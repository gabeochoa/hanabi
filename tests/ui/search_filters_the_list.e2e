# The sidebar search filters the thread list, and clearing it restores.
#
# NOTE: expect_no_text takes a BARE single word — see afterhours_gaps.md upstream 2d6f23d.
#
# settings: {"window_width":1100,"window_height":760,"open_tabs":[],"active_tab":"","theme":"dark"}

# The second row is one whose Home card is below the fold, so what this
# watches disappear is the sidebar row and not a card the filter never touched.
expect_text "profiling the disk"
expect_text "quota migration, week 3"

click 140 58
wait_frames 4
type "disk"
wait_frames 8

expect_text "profiling the disk"
expect_no_text quota
