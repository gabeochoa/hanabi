# A colour choice made in an earlier run comes back on launch.
#
# The settings file here is what the previous run would have written. Without
# the load path the sheet would open on "Default" — which is exactly what a
# choice that persists in name only looks like.
#
# settings: {"window_width":1100,"window_height":760,"open_tabs":[],"active_tab":"","theme":"dark","theme_accent":"amber","theme_highlight":"pink"}

click_ui sb_settings
wait_frames 8
click_ui sb_settings_nav_appearance
wait_frames 8
# The Theme rows sit below the fold at this height under the reference face.
hover_ui settings_pane_scroll
wait_frames 2
scroll_wheel 0 -200
wait_frames 6
expect_text "Accent   ·   Amber"
expect_text "Find highlight   ·   Pink"
