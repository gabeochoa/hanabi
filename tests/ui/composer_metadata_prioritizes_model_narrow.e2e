# Compact composer chrome keeps the control that identifies future work -- the
# one model chip (effort is a section of its panel now) -- and drops the
# optional tool-fold pill first.
# settings: {"window_width":760,"window_height":620,"open_tabs":["t2"],"active_tab":"t2","theme":"dark"}
# env: HANABI_WIN_W=760 HANABI_WIN_H=620

require_thread t2
wait_frames 12
assert_ui composer_model hidden=false
expect_no_ui composer_effort
# The chip names what runs: the harness default, Opus 5, on an untuned thread.
expect_text "Opus 5"
expect_no_text "Tools: Folded"
