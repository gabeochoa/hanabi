# A playing clip belongs to its row: closing the tab that shows it hands
# stop to the native boundary (the runner's private audio log; no speaker),
# and nothing plays for a thread no pane shows.
# settings: {"window_width":1100,"window_height":760,"open_tabs":["t1","t2"],"active_tab":"t1","theme":"dark"}
# env: HANABI_ARTIFACT_DEMO=1 HANABI_OPEN=t1
require_thread t1
assert_ui artifact_clip_play hidden=false
click_ui artifact_clip_play
wait_frames 6
expect_audio_log play approval-note within=60
assert_ui artifact_clip_pause hidden=false
click_ui tab_close
expect_tab t1 absent within=60
expect_open t2
expect_audio_log stop approval-note within=60
expect_no_ui artifact_clip_pause
