# settings: {"window_width":1100,"window_height":1400,"open_tabs":[],"active_tab":"","theme":"dark"}
# env: HANABI_TOOLS_DEMO=stretch HANABI_OPEN=rtools
# Unattended work between two things said -- two wakes, three runs of tool
# steps, a quiet "completed" outcome and a thought -- folds behind one line
# that says what was work and over what span. A click opens it, its header
# folds it again, and the lone run after the reader's reply stays a run.
# The General switch turns the fold off.
require_thread rtools
wait_frames 12
expect_text "run the nightly checks every hour and report"
expect_text "Worked for 2s across 1h 21m"
assert_ui stretch_tks-w1 hidden=false
expect_no_text "Woke up on the hourly timer"
expect_text "03:00 run green."
click_ui stretch_tks-w1
wait_frames 10
assert_ui stretch_open_tks-w1 hidden=false
expect_text "Worked for 2s across 1h 21m"
expect_text "Woke up on the hourly timer"
click_ui stretch_open_tks-w1
wait_frames 10
assert_ui stretch_tks-w1 hidden=false
expect_no_text "Woke up on the hourly timer"
click_ui sb_settings
wait_frames 16
click_ui sb_settings_nav_general
wait_frames 10
hover_ui settings_pane_scroll
wait_frames 2
scroll_wheel 0 -600
wait_frames 8
click_ui settings_compress_runs
wait_frames 10
key ESCAPE
wait_frames 12
expect_no_ui stretch_tks-w1
expect_text "Woke up on the hourly timer"
