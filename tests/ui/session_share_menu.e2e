# Sidebar rows expose the same share primitives as open tabs.
# settings: {"window_width":1100,"window_height":760,"open_tabs":[],"active_tab":"","theme":"dark"}
# env: HANABI_WEB_BASE_URL=https://navi.test/session

expect_text "needs a decision before it can go on"
# By TITLE, not a y coordinate: the row pitch is the reference's 34 now and
# the list carries section headers, so a hardcoded y names the neighbour.
right_click_text "needs a decision before it can go on"
wait_frames 4
expect_text "Copy Weblink"
expect_text "Copy Session ID"
reset_clipboard_probe
click_ui row_menu_copy_link
expect_clipboard "https://navi.test/session/t2"

right_click_text "needs a decision before it can go on"
wait_frames 4
reset_clipboard_probe
click_ui row_menu_copy_id
expect_clipboard "t2"
