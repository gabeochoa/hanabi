# settings: {"window_width":1100,"window_height":760,"open_tabs":["t2"],"active_tab":"t2","theme":"dark"}
# env: HANABI_ASK_DEMO=approval HANABI_TEST_OVERLAY=settings

require_thread t2
expect_text "The agent needs approval"

focus_ui ask_decline
key ENTER
wait_frames 20
expect_no_text "Sending your answer…"
expect_text "The agent needs approval"

focus_ui ask_submit
key ENTER
wait_frames 20
expect_no_text "Sending your answer…"
expect_text "The agent needs approval"
expect_text "./scripts/release_batch.sh --force"

key ESCAPE
wait_frames 20
expect_no_text "Appearance, behavior, notifications, and local data"

focus_ui ask_submit
key ENTER
wait_frames 25
expect_no_text "The agent needs approval"
