# find_paints_a_match_that_wraps.e2e at Line spacing 150%. Over 100% a wrapped
# paragraph is drawn one label per line with the room between them, while
# find still reads it as ONE text laid out with that gap -- so the phrase
# broken across the wrap is still counted once and painted, in two pieces.
#
# settings: {"window_width":1000,"window_height":760,"open_tabs":["r2"],"active_tab":"r2","theme":"dark","line_spacing":150}
# env: HANABI_FIND_DEMO='The import' HANABI_FIND_AUDIT=1

require_thread r2

expect_text "1 of 1"
expect_text "bands 1"
