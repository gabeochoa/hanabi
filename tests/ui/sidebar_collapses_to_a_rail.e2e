# The panel toggle folds the sidebar to an icon rail and back.
#
# NOTE: assert on VIEWS (the section header strip), not on the search field's
# placeholder — the placeholder is painted through on_draw_fg (afterhours has
# no native placeholder, gap #29) and never reaches the visible-text registry.
# The toggle lives at the right edge of that strip now, not in a header row:
# the sidebar's top band is bare window colour where the OS traffic lights sit.
#
# The two clicks are the two toggles: the unfolded one sits in the VIEWS strip
# at x=249..273, y=40..60, and the folded rail's own one at x=14..42, y=7..35.
#
# settings: {"window_width":1100,"window_height":760,"open_tabs":[],"active_tab":"","theme":"dark"}

expect_text "VIEWS"
expect_text "SKU backfill — my name for it"

click 262 50
wait_frames 25
expect_no_text VIEWS

click 22 21
wait_frames 25
expect_text "VIEWS"
