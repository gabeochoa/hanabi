# settings: {"window_width":1100,"window_height":760,"open_tabs":[],"active_tab":"","theme":"dark","read_seq":{"rseq":4}}
# env: HANABI_READ_SEQ_DEMO=1
wait_frames 20
expect_text "the read cursor"
assert_ui row_unread_count text="2 new"
mouse_move 120 300
wait_frames 4
click_ui chat_row_id_rseq
wait_frames 20
expect_open rseq
expect_text "third answer"
key END
wait_frames 20
expect_no_ui row_unread_count
