# settings: {"window_width":1100,"window_height":760,"open_tabs":["t2"],"active_tab":"t2","theme":"dark"}

require_thread t2
wait_frames 20

click 140 58
wait_frames 6
watch_ink typing_search ui sb_search_clear
type "d"
wait_frames 12
expect_latency typing_search 4
click_ui sb_search_clear
wait_frames 8

watch_ink focus_gain focus composer_reply_input
click_ui composer_reply_input
wait_frames 6
expect_latency focus_gain 3
watch_ink focus_loss blur composer_reply_input
click 140 58
wait_frames 6
expect_latency focus_loss 3

click_ui composer_reply_input
wait_frames 4
watch_ink popup_open ui slash_menu
type "/"
wait_frames 10
expect_latency popup_open 3
watch_ink popup_close ui_gone slash_menu
key ESCAPE
wait_frames 8
expect_latency popup_close 3
key ESCAPE
wait_frames 8

click_ui composer_reply_input
type "latency probe turn"
wait_frames 8
watch_ink submit text "Got it"
key ENTER
wait_frames 240
expect_latency submit 4

watch_ink click_feedback text "412"
click_text "two workers still out"
wait_frames 20
expect_latency click_feedback 4
