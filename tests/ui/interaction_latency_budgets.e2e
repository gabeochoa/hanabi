# settings: {"window_width":1100,"window_height":760,"open_tabs":["t2"],"active_tab":"t2","theme":"dark"}

require_thread t2
wait_frames 20

click 140 58
wait_frames 6
watch_ink typing_search ui sb_search_clear
type "d"
wait_frames 12
expect_latency typing_search 4
click_ui sb_search_clear
wait_frames 8

watch_ink focus_gain focus composer_reply_input
click_ui composer_reply_input
wait_frames 6
expect_latency focus_gain 3
watch_ink focus_loss blur composer_reply_input
click 140 58
wait_frames 6
expect_latency focus_loss 3

click_ui composer_reply_input
wait_frames 4
watch_ink popup_open ui slash_menu
type "/"
wait_frames 10
expect_latency popup_open 3
watch_ink popup_close ui_gone slash_menu
key ESCAPE
wait_frames 8
expect_latency popup_close 3
key ESCAPE
wait_frames 8

click_ui composer_reply_input
type "latency probe turn"
wait_frames 8
watch_ink submit text "Got it"
key ENTER
wait_frames 240
expect_latency submit 7

watch_ink click_feedback text "412"
click_text "two workers still out"
wait_frames 20
expect_latency click_feedback 8

# The surfaces the owner feels most: the row menu, the command palette, a
# tooltip's dismissal. Open and close are each one frame of ink in the
# measurements so far; the budgets here are the same 3 the other popups
# carry until a Mac run says 1 holds.
watch_ink row_menu_open ui row_menu
right_click_text "two workers still out"
wait_frames 10
expect_latency row_menu_open 3
watch_ink row_menu_close ui_gone row_menu
key ESCAPE
wait_frames 8
expect_latency row_menu_close 3
watch_ink palette_open ui palette_panel
key CMD+K
wait_frames 10
expect_latency palette_open 3
watch_ink palette_close ui_gone palette_panel
key ESCAPE
wait_frames 8
expect_latency palette_close 3
hover_ui composer_attach
wait_frames 50
expect_text "Attach a file"
watch_ink tooltip_close ui_gone tooltip
key ESCAPE
wait_frames 8
expect_latency tooltip_close 3
