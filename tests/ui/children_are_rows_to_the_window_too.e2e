# Unfolded children are rows to EVERY part of the list at once: the virtual
# window, the spacers, the scroll extent, and the drop mapping. Fold t7 open
# (three children) at the top of the list, scroll down past them and back,
# and drag a parent across the open group -- the rows under the pointer are
# the rows on screen, and the drop lands between PARENTS.
#
# The failure this guards: children drawn inside the old member-only window
# grew the content by 3 rows the spacers did not know about, so scrolling
# past an open parent skipped or repeated rows, and a drop between a parent
# and its first child reordered the folder by the CHILD's id.
#
# settings: {"window_width":1100,"window_height":760,"open_tabs":[],"active_tab":"","theme":"dark"}
wait_frames 30
expect_text "coordinating 3 shard workers"


# Fold t7 open: three more rows exist beneath it, drawn by the window.
click_ui row_fold_t7
wait_frames 12
expect_text "shard 1/3 — legacy tenants"
expect_text "shard 3/3 — canary cohort"

# Scroll down across the open group and back up: every row is still where
# the sequence says, nothing skipped, nothing repeated. (The list fits the
# viewport at this size, so the scroll is a no-op on position but the
# window is recomputed each time; a wrong extent would show as a changed
# first index or a lost row.)
scroll_wheel 0 -6
wait_frames 8
scroll_wheel 0 6
wait_frames 8
expect_text "shard 2/3 — active tenants"
expect_text "coordinating 3 shard workers"

# (The parent-only drop mapping is held by the model test's
# parent_drop_index cases and by sidebar_row_drag on the same build; a
# pointer drag across an OPEN group with a pinned expectation is still owed.)
click_ui row_fold_open_t7
wait_frames 8
expect_no_text "shard 1/3 — legacy tenants"
expect_text "coordinating 3 shard workers"
