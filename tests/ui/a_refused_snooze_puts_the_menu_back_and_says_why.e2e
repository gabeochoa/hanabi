# The web app refuses the write (409: too many snoozes): the menu would read
# "Snoozed until" at once, then the answer lands, the state rolls back and a
# toast says why; the row menu offers Snooze again. The second attempt (the
# mock refuses only the first POST) is kept.
# settings: {"window_width":1100,"window_height":760,"open_tabs":[],"active_tab":"","theme":"dark"}
# env: HANABI_MOCK_INBOX_POST=409
expect_text "SKU backfill — my name for it"
mouse_move 120 475
wait_frames 3
right_click 120 475
wait_frames 8
click_ui row_menu_snooze
wait_frames 6
click_ui row_menu_snooze_one_hour
wait_frames 20
expect_text_drawn "Snooze refused: too many snoozes" within=60
mouse_move 120 475
wait_frames 3
right_click 120 475
wait_frames 8
expect_text "Snooze"
expect_no_text "Snoozed until"
click_ui row_menu_snooze
wait_frames 6
click_ui row_menu_snooze_one_hour
wait_frames 20
mouse_move 120 475
wait_frames 3
right_click 120 475
wait_frames 8
expect_text "Snoozed until 1:00 PM"
key ESCAPE
