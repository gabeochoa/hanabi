# The row menu's flat "Open in Split" (third selectable row: Open, Open & Pin,
# then past the divider) opens a closed thread in the split pane; the menu is
# gone and the divider is drawn.
# settings: {"window_width":1100,"window_height":760,"open_tabs":["t2"],"active_tab":"t2","theme":"dark"}
# env: HANABI_OPEN=t2
require_thread t2
wait_frames 12
right_click_ui chat_row_id_t9
wait_frames 10
arrow down
wait_frames 6
arrow down
wait_frames 6
arrow down
wait_frames 6
expect_text "Open in Split"
key ENTER
wait_frames 30
expect_no_text "CONVERSATION"
assert_ui split_divider w=5
