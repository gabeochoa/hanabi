# settings: {"window_width":1100,"window_height":760,"open_tabs":[],"active_tab":"","theme":"dark"}

expect_text "VIEWS"
expect_no_text "SETTINGS"

click_ui sb_settings
wait_frames 10
expect_text "SETTINGS"
# The shelf STAYS now -- Settings swaps the lower half of the column only,
# which is how you get back to a conversation (the reference's own rule,
# confirmed against its capture). What must not be there is the
# conversation list.
expect_text "VIEWS"
expect_no_ui chat_row
assert_ui sb_settings_nav_general w=268
expect_text "Send message with"

click_ui sb_settings_nav_storage
wait_frames 10
expect_text "Keep at most on disk"
expect_no_text "Send message with"

click_ui tab_close
wait_frames 10
expect_text "VIEWS"
expect_no_text "SETTINGS"
expect_no_text "Keep at most on disk"

click_ui sb_settings
wait_frames 10
expect_text "Keep at most on disk"
expect_text "SETTINGS"

key ESCAPE
wait_frames 10
expect_text "VIEWS"
