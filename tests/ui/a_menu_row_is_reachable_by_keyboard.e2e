# settings: {"window_width":1100,"window_height":760,"open_tabs":[],"active_tab":"","theme":"dark"}
# env: HANABI_MOCK_NO_RENAME=1 HANABI_MOCK_NO_FORK=1

expect_text "needs a decision before it can go on"
wait_frames 12

# By TITLE, not a y coordinate: the row pitch is the reference's 34 now and
# the list carries section headers, so a hardcoded y names the neighbour.
right_click_text "coordinating 3 shard workers"
wait_frames 10
expect_text "CONVERSATION"

# Open, Open & Pin, Open in Split, then past the disabled Rename and Fork
# to Copy Title, then Copy Deeplink: five presses.
arrow down
wait_frames 6
arrow down
wait_frames 6
arrow down
wait_frames 6
arrow down
wait_frames 6
arrow down
wait_frames 6
expect_text "Copy Deeplink"

key ENTER
wait_frames 20
expect_no_text "CONVERSATION"
expect_clipboard "navi://session/t7"

right_click_text "coordinating 3 shard workers"
wait_frames 10
# The flat Open row: Right on it does nothing (no submenu any more); Enter
# opens the thread as a preview, like a click, and the menu is gone.
arrow down
wait_frames 6
arrow right
wait_frames 8
expect_text "CONVERSATION"
expect_no_ui row_menu_open_submenu
key ENTER
wait_frames 16
expect_no_text "CONVERSATION"
expect_open t7
assert_ui tab_preview hidden=false
