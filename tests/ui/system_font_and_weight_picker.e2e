# env: HANABI_ALLOW_SYSTEM_FONTS_HEADLESS=1 HANABI_FONT_AUDIT=1
# settings: {"window_width":1100,"window_height":760,"open_tabs":[],"active_tab":"","theme":"dark","font":"default","font_weight":"regular"}

click_ui sb_settings
wait_frames 8
click_ui sb_settings_nav_appearance
wait_frames 8
# The Typeface rows sit below the fold behind Reading width / Context /
# Composer; scroll with the pointer over the pane first.
hover_ui settings_pane_scroll
wait_frames 2
scroll_wheel 0 -300
wait_frames 6
expect_text "System"
expect_text "Optimistic"
expect_text "Regular"
click_ui settings_font_system
wait_frames 4
expect_text "Semibold"
expect_text "Bold"
click_ui settings_font_weight_bold
wait_frames 4
click_ui tab_close
wait_frames 4
click_ui sb_settings
wait_frames 4
hover_ui settings_pane_scroll
wait_frames 2
scroll_wheel 0 -300
wait_frames 6
expect_text "System"
expect_text "Bold"
