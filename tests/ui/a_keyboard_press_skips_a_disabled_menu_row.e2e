expect_text "needs a decision before it can go on"
wait_frames 12
# By TITLE, not a y coordinate: the row pitch is the reference's 34 now and
# the list carries section headers, so a hardcoded y names the neighbour.
right_click_text "coordinating 3 shard workers"
wait_frames 10
expect_text "CONVERSATION"

arrow down
wait_frames 6
arrow down
wait_frames 6
arrow down
wait_frames 6
expect_text "Copy session link"

key ENTER
wait_frames 20
expect_no_text "CONVERSATION"
expect_clipboard "navi://session/t7"
