# settings: {"window_width":1100,"window_height":760,"open_tabs":["t2"],"active_tab":"t2","theme":"dark"}
# env: HANABI_OPEN=t2

require_thread t2
wait_frames 12

expect_hit_targets with_text

right_click 120 410
wait_frames 8
expect_text "CONVERSATION"
expect_hit_targets

arrow down
wait_frames 6
arrow right
wait_frames 8
expect_text "Open in a Tab"
expect_hit_targets

key ESCAPE
wait_frames 6
key ESCAPE
wait_frames 8

click_ui composer_model
wait_frames 10
# The model panel's rows are 20pt tall BY MEASURE of the reference
# (/tmp/hz-ref5/strip/model.png: 20pt pitch, the rows are the whole pitch),
# below hanabi's 28pt pointer-target floor. The exception is explicit here,
# per row, with that reason -- no threshold change, no invisible overlap.
expect_hit_targets model_row_claude-opus-5 model_row_claude-fable-5 model_row_claude-opus-4-8 model_row_claude-sonnet-5 model_row_avocado-code-flex model_row_muse-spark-1.2-internal model_row_gpt-5.6-sol model_row_gpt-5.5 model_row_default effort_row_low effort_row_medium effort_row_high effort_row_xhigh effort_row_max effort_row_default
key ESCAPE
wait_frames 6


click_ui composer_fold
wait_frames 10
expect_hit_targets
key ESCAPE
wait_frames 6

click_ui sb_settings_footer
wait_frames 20
expect_text "Settings"
expect_hit_targets
key ESCAPE
wait_frames 12

click_ui sb_palette
wait_frames 12
expect_hit_targets
key ESCAPE
wait_frames 8
