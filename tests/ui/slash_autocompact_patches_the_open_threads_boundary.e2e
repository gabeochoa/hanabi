# settings: {"window_width":1100,"window_height":760,"open_tabs":["t2"],"active_tab":"t2","theme":"dark"}
require_thread t2
wait_frames 10
click_ui composer_reply_input
type "/autocompact"
wait_frames 4
key ESCAPE
wait_frames 4
key ENTER
wait_frames 10
expect_text "This thread compacts on Auto."
type "/autocompact 60"
key ENTER
wait_frames 30
expect_text "This thread compacts at 60%."
expect_input_text composer_reply_input ""
type "/autocompact default"
key ENTER
wait_frames 30
expect_text "This thread compacts on Auto."
