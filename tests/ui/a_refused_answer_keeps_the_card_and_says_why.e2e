# settings: {"window_width":1100,"window_height":760,"open_tabs":["t2"],"active_tab":"t2","theme":"dark"}
# env: HANABI_ASK_DEMO=1 HANABI_ASK_FAIL='the orchestrator refused that answer'

require_thread t2
