# settings: {"window_width":1500,"window_height":760,"open_tabs":["t1","t2","t3"],"active_tab":"t1","theme":"dark"}

require_thread t1
expect_groups "t1,t2,t3" 0 "t1"
key CMD+ALT+BACKSLASH
wait_frames 30
expect_groups "t2,t3|t1" 1 "t2,t1"
key CMD+CTRL+SHIFT+LEFT
wait_frames 30
expect_groups "t1|t2,t3" 0 "t1,t2"
key CMD+CTRL+RIGHT
wait_frames 4
key CMD+ALT+SHIFT+BACKSLASH
wait_frames 30
expect_groups "t1|t3|t2" 2 "t1,t3,t2"
key CMD+BACKSLASH
wait_frames 30
expect_groups "t1,t3,t2" 0 "t2"
