# A tab chord counts along the FOCUSED pane's strip and shows its tab in that
# pane, leaving the other pane alone -- Cmd+1...8 are the nth tab of the pane
# the keyboard is in and Cmd+9 is that pane's last, which is how Puffin
# counts chips (a pane is what draws a strip).
#
# Asserted with expect_groups, which says what each pane holds, which pane has
# the keyboard and what each pane shows, so the chord's pane is a fact rather
# than something to infer from what survives a close.
#
# settings: {"window_width":1100,"window_height":760,"open_tabs":["t1","t2","t3"],"active_tab":"t1","theme":"dark"}

require_thread t1
wait_frames 20

# Split: t1 moves to a pane of its own on the right and takes the keyboard.
key CTRL+BACKSLASH
wait_frames 20
assert_ui split_right hidden=false
assert_ui split_focus_edge x=693
expect_groups "t2,t3|t1" 1 "t2,t1"

# Keyboard into the left pane, whose strip is t2, t3.
click 400 400
wait_frames 12
assert_ui split_focus_edge x=280
expect_groups "t2,t3|t1" 0 "t2,t1"

# Cmd 2 is the second tab OF THIS PANE: t3, not the window's second tab.
key CTRL+2
wait_frames 30
require_thread t3
expect_groups "t2,t3|t1" 0 "t3,t1"

key CTRL+1
wait_frames 30
expect_groups "t2,t3|t1" 0 "t2,t1"

# Cmd 9 is the pane's last tab.
key CTRL+9
wait_frames 30
expect_groups "t2,t3|t1" 0 "t3,t1"

# The right pane's strip holds one tab, so its second slot names nothing.
click 900 400
wait_frames 12
assert_ui split_focus_edge x=693
key CTRL+2
wait_frames 20
expect_groups "t2,t3|t1" 1 "t3,t1"
