# Which key sends is a SETTING, and changing it changes what Return does — in
# this same process, to this same composer field.
#
# That last part is the whole point of the test. The submit listener is
# attached with addComponentIfMissing, so the one attached on some early frame
# is the one that runs forever: anything it decides is frozen at that moment.
# Enter-to-send already shipped that bug once (the ENTER-TO-SEND comment in
# render_composer is its scar). A test that started the app with Cmd+Return
# already chosen would pass with a listener that read the setting once and
# froze it, so this script flips the setting at runtime and asserts the
# behaviour swaps underneath the field that is already on screen.
#
# Cmd+Return itself cannot be scripted — the injector cannot synthesise a Cmd
# chord (afterhours_gaps.md #49) — so the arm this proves is that plain Return
# STOPS sending, and the composer's own hint stops claiming it does. That the
# chord then sends is asserted where it can be: hanabi::enter_sends, unit
# tested in tests/unit/test_settings.cpp against both settings.
#
# settings: {"window_width":1100,"window_height":760,"open_tabs":["t2"],"active_tab":"t2","theme":"dark"}

require_thread t2

expect_text "needs a decision"

# ---- Default: Return sends -----------------------------------------------
# Focus the composer BY NAME. This was `click 646 674` — a literal point four
# pixels inside the field's top edge — and feat/vis-statusmove moved the whole
# composer 26px down (hanabi reserved a status strip at the window's floor that
# Puffin has no equivalent of; layout_system.h). The point then landed on the
# transcript, the typing went nowhere, and six scripts in this directory failed
# on one edit. `click_ui` takes the widget's centre, so it cannot break on
# layout again.
click_ui composer_reply_input
wait_frames 4
type "return should send this"
wait_frames 4
expect_text "Enter to send"
key ENTER
wait_frames 40

expect_text "return should send this"
# The field emptied, which is the other half of "it was sent".
expect_input_text composer_reply_input ""

# ---- Switch the setting to Cmd+Return ------------------------------------
click_ui sb_settings
wait_frames 8
expect_text "Send with"
click_ui settings_send_key_1
wait_frames 6
click_ui settings_close
wait_frames 8

# ---- Now Return does NOT send --------------------------------------------
click_ui composer_reply_input
wait_frames 4
type "return must not send this"
wait_frames 4
# The hint names the key that actually sends now, not the one that used to.
expect_text "Cmd+Return to send"
key ENTER
wait_frames 40

# Nothing was sent and nothing was thrown away. Return now BREAKS THE LINE
# here rather than doing nothing at all, which is the point of choosing
# "Cmd+Return sends": the composer is a text_area, and its Enter behaviour is
# recomputed every frame from hanabi::enter_sends, so under this setting Enter
# is a newline and only Cmd+Return submits. The field held 25 characters and
# now holds 26 — the draft plus the break. (Byte counts, not text: the script
# parser has no way to spell a newline inside an argument, gap #259.)
key CMD+A
wait_frames 6
expect_input_selection composer_reply_input 0 26

# ---- And switching back restores Return ----------------------------------
click_ui sb_settings
wait_frames 8
click_ui settings_send_key_0
wait_frames 6
click_ui settings_close
wait_frames 8

click_ui composer_reply_input
wait_frames 4
expect_text "Enter to send"
key ENTER
wait_frames 40

expect_text "return must not send this"
expect_input_text composer_reply_input ""
