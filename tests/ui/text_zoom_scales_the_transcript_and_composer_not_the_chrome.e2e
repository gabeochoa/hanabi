# env: HANABI_ALLOW_SYSTEM_FONTS_HEADLESS=1
# Every number below was measured with installed fonts allowed (the C35 sweep
# set this for the whole suite); under the bundled faces the wraps and the
# settings anchors differ, so the dependency is declared, not inherited.
# settings: {"window_width":1100,"window_height":760,"open_tabs":["t2","t6"],"active_tab":"t2","theme":"dark"}
require_thread t2
wait_frames 16
expect_text "Reconcile this cycle's Stars payouts"
assert_ui user_bubble h=35
assert_ui user_avatar w=20 h=20
assert_ui composer_reply_input h=29
assert_ui composer_input_wrap h=46
assert_ui sidebar w=280
assert_ui tab_active h=33
key CTRL+=
wait_frames 12
assert_ui user_bubble h=37
assert_ui composer_reply_input h=31
assert_ui composer_input_wrap h=48
assert_ui user_avatar w=20 h=20
assert_ui sidebar w=280
assert_ui tab_active h=33
key CTRL+=
wait_frames 12
assert_ui user_bubble h=38
assert_ui composer_reply_input h=33
assert_ui composer_input_wrap h=50
key CTRL+=
wait_frames 12
assert_ui user_bubble h=61
expect_ui_rel user_bubble inside user_row
expect_ui_rel user_bubble right_edge user_row
assert_ui composer_reply_input h=35
assert_ui composer_input_wrap h=52
click_ui tab_t6
wait_frames 16
expect_open t6
click_ui tab_t2
wait_frames 16
expect_open t2
assert_ui user_bubble h=61
expect_ui_rel user_bubble inside user_row
key CTRL+0
wait_frames 12
assert_ui user_bubble h=35
assert_ui composer_reply_input h=29
assert_ui composer_input_wrap h=46
key CTRL+SHIFT+=
wait_frames 12
assert_ui user_bubble h=37
assert_ui composer_reply_input h=31
assert_ui composer_input_wrap h=48
key CTRL+0
wait_frames 12
assert_ui user_bubble h=35
key CTRL+SHIFT+-
wait_frames 12
assert_ui user_bubble h=35
assert_ui composer_reply_input h=29
assert_ui composer_input_wrap h=46
key CTRL+-
wait_frames 12
assert_ui user_bubble h=33
assert_ui composer_reply_input h=27
assert_ui composer_input_wrap h=44
assert_ui sidebar w=280
assert_ui tab_active h=33
reload_settings
wait_frames 12
assert_ui user_bubble h=33
assert_ui composer_reply_input h=27
assert_ui composer_input_wrap h=44
key CTRL+0
wait_frames 12
assert_ui user_bubble h=35
assert_ui composer_reply_input h=29
assert_ui composer_input_wrap h=46
