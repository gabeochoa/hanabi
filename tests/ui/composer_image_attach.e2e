# The production composer stages every supported file kind, removes one by
# keyboard-addressable control, and sends the remaining files with a kickoff.
# settings: {"window_width":1100,"window_height":760,"open_tabs":[],"active_tab":"","theme":"dark"}
# env: HANABI_DROP_TEST='tests/fixtures/attachments/sample.png;tests/fixtures/attachments/sample.md;tests/fixtures/attachments/sample.txt;tests/fixtures/attachments/sample.pdf'

expect_text "sample.png"
expect_text "sample.md"
expect_text "sample.txt"
expect_text "sample.pdf"
expect_text "Ready to send"
assert_ui composer_attachments h=60
assert_ui attach_chip_0 hidden=false
assert_ui attach_chip_3 hidden=false

click_ui attach_remove_2
wait_frames 6
expect_no_text sample.txt
expect_text sample.pdf

click_ui composer_reply_input
wait_frames 3
type "inspect the attached evidence"
click_ui composer_send
wait_frames 50

expect_text "inspect the attached evidence"
expect_text "Image · sample.png"
expect_text "File · sample.md"
expect_text "File · sample.pdf"
expect_no_text "Ready to send"
