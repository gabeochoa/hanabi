# settings: {"window_width":1100,"window_height":760,"open_tabs":[],"active_tab":"","theme":"dark"}

click_ui sb_settings
wait_frames 10
expect_focused settings_search

click_ui tab_close
wait_frames 10
expect_focused sb_settings

click_ui sb_settings
wait_frames 10
expect_focused settings_search
# Escape drops the caret but leaves the tab up (a tab closes by its x); the
# keyboard comes back to the sidebar's Settings row when the tab CLOSES.
key ESCAPE
wait_frames 10
click_ui tab_close
wait_frames 12
expect_focused sb_settings
