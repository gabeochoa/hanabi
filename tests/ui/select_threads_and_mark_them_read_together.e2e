# settings: {"window_width":1100,"window_height":1400,"open_tabs":[],"active_tab":"","theme":"dark","read_seq":{"rseq":4}}
# env: HANABI_READ_SEQ_DEMO=1 HANABI_MOCK_JOURNAL=/tmp/hanabi-e2e-bulk-read-journal.jsonl
# Selection mode from the list options menu: the toolbar replaces the search
# field with the count, each click toggles a row, Mark read acts on the
# selected rows and what succeeded leaves the selection; Cancel brings the
# search field back.
clear_mock_journal
wait_frames 20
expect_text "2 new"
click_ui sb_search_filter
wait_frames 6
expect_text "Select threads…"
click_ui list_menu_select
wait_frames 6
expect_text "0 selected"
expect_no_ui sb_search
click_ui chat_row_id_rseq
wait_frames 4
expect_text "1 selected"
assert_ui row_selected_rseq hidden=false
click_ui chat_row_id_t2
wait_frames 4
expect_text "2 selected"
click_ui chat_row_id_t2
wait_frames 4
expect_text "1 selected"
assert_ui row_select_t2 hidden=false
click_ui chat_row_id_t2
wait_frames 4
click_ui bulk_read
wait_frames 30
expect_text "0 selected"
expect_no_text "2 new"
expect_mock_journal "\"session_id\":\"rseq\""
click_ui bulk_cancel
wait_frames 6
assert_ui sb_search hidden=false
expect_no_ui bulk_count
