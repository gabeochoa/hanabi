# While a text field holds the keyboard, the reading keys belong to it.
#
# Home and End move the caret in a composer, not the transcript behind it —
# getting this wrong means the view jumps to the top of the thread the moment
# someone presses Home while editing a message.
#
# settings: {"window_width":1100,"window_height":760,"open_tabs":[],"active_tab":"","theme":"dark"}
# env: HANABI_BIG_TRANSCRIPT=1 HANABI_OPEN=rbig

require_thread rbig

expect_no_text #0:
assert_ui transcript_bottom_pad y=646

# Focus the composer and type, then press Home: the caret moves, the thread
# stays where it was.
# Focus the composer BY NAME. This was `click 646 674` — a literal point four
# pixels inside the field's top edge — and feat/vis-statusmove moved the whole
# composer 26px down (hanabi reserved a status strip at the window's floor that
# Puffin has no equivalent of; layout_system.h). The point then landed on the
# transcript, the typing went nowhere, and six scripts in this directory failed
# on one edit. `click_ui` takes the widget's centre, so it cannot break on
# layout again.
click_ui composer_reply_input
wait_frames 4
type "still at the bottom"
wait_frames 4
expect_input_selection composer_reply_input 19 19
key HOME
wait_frames 12
expect_input_selection composer_reply_input 0 0
expect_no_text #0:
assert_ui transcript_bottom_pad y=646
expect_text "still at the bottom"
