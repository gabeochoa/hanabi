# settings: {"window_width":1100,"window_height":760,"open_tabs":["t2","t9"],"active_tab":"t9","theme":"dark"}
# env: HANABI_MOCK_SNOOZES=t9:1781528400:1781524740 HANABI_MOCK_ROW_CLOCKS=t9:1781524700000,t9:1781524770000@2
require_thread t9
wait_frames 20
assert_ui tab_t2 hidden=false
expect_backend_state t9 running
right_click_ui chat_row_id_t9
wait_frames 8
expect_text "Snoozed until 1:00 PM"
wait_frames 32
key ESCAPE
wait_frames 4
expect_input_text composer_reply_input ""
click_ui composer_send
wait_frames 16
expect_backend_state t9 ready
right_click_ui chat_row_id_t9
wait_frames 8
expect_text "Snooze"
expect_no_text "Snoozed until"
wait_frames 32
key ESCAPE
wait_frames 4
click_ui tab_t2
wait_frames 12
expect_open t2
assert_ui tab_t9 hidden=false
right_click_ui tab_t9
wait_frames 8
expect_text "Snoozed until 1:00 PM"
wait_frames 32
key ESCAPE
