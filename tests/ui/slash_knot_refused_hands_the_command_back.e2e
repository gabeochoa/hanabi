# A /knot Knots refuses comes back to the composer it was typed in, with the
# refusal said plainly -- nothing typed is lost.
#
# settings: {"window_width":1100,"window_height":760,"open_tabs":["t2"],"active_tab":"t2","theme":"dark"}
# env: HANABI_MOCK_KNOTS=fail

require_thread t2
click_ui composer_reply_input
wait_frames 6
type "/knot keep this text"
wait_frames 6
key ESCAPE
wait_frames 4
key ENTER
wait_frames 30
expect_text "Knots refused it"
expect_input_text composer_reply_input "/knot keep this text"
