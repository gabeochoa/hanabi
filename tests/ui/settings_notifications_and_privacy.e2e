# settings: {"window_width":1100,"window_height":760,"open_tabs":[],"active_tab":"","theme":"dark","settings_pane":"notifications"}
# env: HANABI_TEST_OVERLAY=settings

wait_frames 10
expect_text "Show notifications"
expect_text "Play a sound"
expect_text "Chime when a run finishes"
expect_text "Notify me about sub-agents"
expect_text "Quiet hours"

# One switch: a click toggles it off, a second click toggles it back on.
click_ui settings_notify_show
wait_frames 10
expect_text "notifications are off"

click_ui settings_notify_show
wait_frames 10
expect_no_text "notifications are off"

click_ui sb_settings_nav_connection
wait_frames 10
expect_text "Send settings to your account"
# (hosted panes show the origin as a capsule, not a sentence)
expect_text "Read-only"
expect_text "Set in your config file or environment; a change takes effect at the next launch."

click_ui settings_search
wait_frames 6
type "telemetry"
wait_frames 10
expect_text "Send settings to your account"
