# settings: {"window_width":1100,"window_height":760,"open_tabs":[],"active_tab":"","theme":"dark"}
# env: HANABI_MOCK_NO_RENAME=1

expect_text "needs a decision before it can go on"
wait_frames 12

expect_a11y "New conversation" role=AXButton
expect_a11y "Open settings" role=AXButton

right_click 120 410
wait_frames 10

expect_a11y "CONVERSATION" role=AXMenu
expect_a11y "Archive" role=AXMenuItem parent=CONVERSATION
expect_a11y "Rename…" role=AXMenuItem parent=CONVERSATION says="Rename…, menuitem, dimmed"
expect_a11y "Open…" role=AXMenuItem parent=CONVERSATION

arrow down
wait_frames 6
expect_a11y "Open…" says="Open…, menuitem, selected, submenu"

arrow right
wait_frames 8
expect_a11y "Open…" says="Open…, menuitem, selected, submenu expanded" children=2
expect_a11y "Open in a tab" role=AXMenuItem parent=Open…
expect_a11y "Open in split" role=AXMenuItem parent=Open…

key ESCAPE
wait_frames 8
key ESCAPE
wait_frames 8
