# settings: {"window_width":1100,"window_height":760,"open_tabs":["t2"],"active_tab":"t2","theme":"dark","line_spacing":130}
# Line spacing opens room between lines only (D123401189), so a one-line
# bubble is its zoomed 100% height: 35 at 100% zoom, 37 one step up (a
# round(16 * 1.1) = 18px line).
require_thread t2
wait_frames 16
assert_ui user_bubble h=35
assert_ui composer_reply_input h=29
key CTRL+=
wait_frames 12
assert_ui user_bubble h=37
assert_ui composer_reply_input h=31
key CTRL+0
wait_frames 12
assert_ui user_bubble h=35
assert_ui composer_reply_input h=29
