# settings: {"window_width":1100,"window_height":760,"open_tabs":["t2"],"active_tab":"t2","theme":"dark"}
# env: HANABI_ASK_DEMO=1 HANABI_ASK_FAIL=echo

require_thread t2
expect_text "The agent is asking"

focus_ui ask_decline
key ESCAPE
wait_frames 20
expect_text "cancel — press Escape to try again."
expect_no_text "decline — press Decline to try again."
expect_no_text "accept — press Submit to try again."
