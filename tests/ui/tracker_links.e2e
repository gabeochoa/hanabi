# A work-tracker id in a reply opens the tracker.
#
# "Built the config diff D948120 adding Tier 1/2/3 price points" — the id is a
# reference to something that lives elsewhere, and it used to be prose. It is
# now drawn as a link and a press on it opens the configured tracker.
#
# The click is by COORDINATE, which the harness otherwise discourages, because
# the thing under test IS a hit test: the id is a byte range inside one wrapped
# label, not an element, so there is no name to click (afterhours_gaps.md #51 —
# nothing will say where a byte range landed, so both the underline and this
# hit test re-derive the wrap). The point below is the centre of the rect that
# re-derivation produces for D948120 in this thread at 1100x760; if the layout
# moves, this fails loudly rather than passing on empty space.
#
# The browser is never launched: a headless render has nobody to hand it to,
# so the open is recorded and the transcript's own confirmation is what is
# asserted here (src/ui/link_detect.h).
#
# settings: {"window_width":1100,"window_height":760,"open_tabs":["t1"],"active_tab":"t1","theme":"dark"}
# env: HANABI_TRACKER_BASE_URL=https://tracker.example.com

expect_text "Built the config diff"

mouse_move 456 492
wait_frames 4
click 456 492
wait_frames 10
expect_text "Opened D948120"
