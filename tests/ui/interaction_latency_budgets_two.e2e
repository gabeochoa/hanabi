# settings: {"window_width":1100,"window_height":760,"open_tabs":["t2","t9"],"active_tab":"t2","theme":"dark"}
# env: HANABI_PICK_FILE_TEST='tests/fixtures/attachments/sample.pdf;tests/fixtures/attachments/sample.md'

require_thread t2
wait_frames 20

watch_ink session_switch_forward text "Kicked 41"
click_ui tab_t9
wait_frames 20
expect_latency session_switch_forward 7
watch_ink session_switch_back text "Reconciled 4,812"
click_ui tab_t2
wait_frames 20
expect_latency session_switch_back 6

focus_ui composer_attach
expect_focused composer_attach
watch_ink attachment_stage ui attach_chip_0
enter
wait_frames 24
expect_latency attachment_stage 7

right_click_text "needs a decision before it can go on"
wait_frames 8
watch_ink sheet_open ui rename_panel
click_ui row_menu_rename
wait_frames 12
expect_latency sheet_open 4
watch_ink sheet_close ui_gone rename_panel
key ESCAPE
wait_frames 12
expect_latency sheet_close 4
