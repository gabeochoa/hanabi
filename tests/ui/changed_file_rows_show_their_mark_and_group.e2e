# settings: {"window_width":1100,"window_height":760,"open_tabs":[],"active_tab":"","theme":"dark"}
# env: HANABI_CHANGES_DEMO=1 HANABI_OPEN=t1
require_thread t1
wait_frames 10
click_ui composer_changes
wait_frames 10
expect_text "2 files changed"
assert_ui changes_group_docs text="Docs"
assert_ui changes_group_code text="Code"
expect_no_ui changes_group_tests
assert_ui changes_path_0 text="src/billing/prorate.ts"
assert_ui changes_path_1 text="docs/upgrade-plan.md"
assert_ui changes_mark_modified text="M"
expect_no_ui changes_mark_added
expect_ui_rel changes_group_docs above changes_group_code
expect_ui_rel changes_counts_0 same_y changes_path_0
key ESCAPE
