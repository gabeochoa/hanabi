# Space settings: members and people found by name show faces (the
# reference's PersonFace / PeoplePhotoStore, kt-eofk): a photo where the
# person has one, else the monogram -- and the name never waits for it.
#
# settings: {"window_width":1100,"window_height":760,"open_tabs":[],"active_tab":"","theme":"dark"}
# env: HANABI_MOCK_SPACE_FILING=t9:1593993452358360

wait_frames 30
right_click_text "SUBS"
wait_frames 6
click_ui space_menu_settings
wait_frames 30
assert_ui person_photo_100000000000001 hidden=false
assert_ui person_monogram_100000000000002 hidden=false
expect_text "Kim Park"
click_ui space_settings_add
type "Dev"
wait_frames 40
assert_ui person_photo_100000000000003 hidden=false
