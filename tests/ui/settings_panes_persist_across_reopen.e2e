# settings: {"window_width":1100,"window_height":760,"open_tabs":[],"active_tab":"","theme":"dark"}

expect_no_text "BACKEND"

click_ui sb_settings
wait_frames 8

# Hosted in a TAB the panel fills the pane, so a fixed sheet width is not a
# fact about it any more; what is: the pane list is in the sidebar and the
# search row is drawn.
assert_ui sb_settings_nav hidden=false
assert_ui settings_search_row hidden=false

expect_text "APP"
expect_text "BACKEND"
expect_text "INPUT"
expect_text "SYSTEM"

expect_text "General"
expect_text "Appearance"
expect_text "Notifications"
expect_text "Storage"
expect_text "Connection"
expect_text "Shortcuts"
expect_text "About"

# (the pane has no subtitle now; its first row says which pane is up)
expect_text "Send message with"
expect_text "Send message with"
expect_no_text "Rotate theme"

click_ui sb_settings_nav_appearance
wait_frames 8
expect_text "Rotate theme"
# The pane has no subtitle now (the reference's pane opens with its content); its
# first section title says which pane is up.
expect_text "Reading width"
expect_no_text "Send message with"

click_ui sb_settings_nav_storage
wait_frames 8
expect_text "Keep at most on disk"
expect_text "Export conversations"
expect_no_text "Rotate theme"

click_ui tab_close
wait_frames 8
expect_no_text "Keep at most on disk"

click_ui sb_settings
wait_frames 8
expect_text "Keep at most on disk"
expect_no_text "Send message with"

# A tab closes by its x, not Escape; the selected pane must survive the
# close and come back on reopen.
click_ui tab_close
wait_frames 8
expect_no_text "Keep at most on disk"

click_ui sb_settings
wait_frames 8
expect_text "Keep at most on disk"
