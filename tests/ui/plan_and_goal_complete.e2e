# settings: {"window_width":1100,"window_height":760,"open_tabs":["t2"],"active_tab":"t2","theme":"dark"}
# env: HANABI_PLAN_DEMO=complete

require_thread t2
expect_text "Plan complete"

click_ui composer_plan
wait_frames 8
expect_text "GOAL  ·  COMPLETED"
expect_text "Released after every account matched"
expect_text "Load the payout ledger  · complete"
expect_text "Release the batch  · complete"

key ESCAPE
wait_frames 6
expect_no_text "GOAL  ·  COMPLETED"
expect_text "Plan complete"
