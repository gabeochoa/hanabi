# settings: {"window_width":1100,"window_height":760,"open_tabs":["t2","t6"],"active_tab":"t2","theme":"dark"}
require_thread t2
wait_frames 20
assert_ui chat_row_id_t9 hidden=false
expect_ui_rel chat_row_id_t9 above chat_row_id_t6
expect_ui_rel chat_row_id_t6 above chat_row_id_t2
click_ui composer_reply_input
wait_frames 4
type "first"
wait_frames 6
click_ui composer_send
wait_frames 60
expect_backend_message t2 first
expect_ui_rel chat_row_id_t2 above chat_row_id_t9
expect_ui_rel chat_row_id_t2 above chat_row_id_t6
click_ui tab_t6
wait_frames 12
expect_open t6
wait_frames 90
click_ui composer_reply_input
wait_frames 4
type "second"
wait_frames 6
click_ui composer_send
wait_frames 60
expect_backend_message t6 second
expect_ui_rel chat_row_id_t6 above chat_row_id_t9
expect_ui_rel chat_row_id_t2 above chat_row_id_t6
wait_frames 40
expect_ui_rel chat_row_id_t2 above chat_row_id_t6
expect_ui_rel chat_row_id_t6 above chat_row_id_t9
