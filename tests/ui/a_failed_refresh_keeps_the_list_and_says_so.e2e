# A list refresh that fails behind a list already on screen keeps the list
# AND says so (the reference's 0.8.3: sign-in failures explain themselves and keep the
# list on screen). The second list call is refused the way a credential the
# server stopped accepting is; the rows stay, and one notice names the reason.
#
# settings: {"window_width":1100,"window_height":760,"open_tabs":["t2"],"active_tab":"t2","theme":"dark"}
# env: HANABI_MOCK_LIST_FAIL_FROM=2

require_thread t2
expect_text "profiling the disk"
expect_no_toast

refresh_list
wait_frames 20
# A refused credential is SIGNED OUT, said in words with no status code
# (kt-qu8m); the list stays.
expect_toast "Signed out of Agentcloud on this Mac"
expect_no_text "(401)"
# The list is still the list.
expect_text "profiling the disk"
expect_text "20 sessions"

# Once per failure streak: a second failed refresh raises nothing new.
click_ui toast_close
wait_frames 10
expect_no_toast
refresh_list
wait_frames 20
expect_no_toast
expect_text "profiling the disk"
