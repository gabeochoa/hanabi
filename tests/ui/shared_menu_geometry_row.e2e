# settings: {"window_width":1100,"window_height":760,"open_tabs":[],"active_tab":"","theme":"dark"}

expect_text "needs a decision before it can go on"
right_click 120 400
wait_frames 8

expect_text "CONVERSATION"
# 702 tall now (Move to Space and Move to Folder after Snooze, +72; Snooze after Mute, +36; before that 594: Open, Open & Pin, a divider, Open in Split, a divider added
# to the 396 of the grouped menu; then Copy Deeplink beside Copy Weblink,
# two rows always, +36; then Pin before Mute, +36; then Export to Clipboard
# in its own group, +36 +9) -- taller than the room below a click at
# y=400 in a 760 window, so the menu is clamped upward and every row's y
# moves with it; the rows are pinned by x/w/h and order, their y's by the
# runtime dump once the primary reads them.
assert_ui row_menu x=120 w=184 h=702
assert_ui row_menu_eater w=1100 h=760
assert_ui row_menu_title h=28
assert_ui row_menu_open x=124 w=176 h=36
assert_ui row_menu_open_pin w=176 h=36
assert_ui row_menu_open_split w=176 h=36
assert_ui row_menu_rename w=176 h=36
assert_ui row_menu_copy_title w=176 h=36
assert_ui row_menu_fork w=176 h=36
assert_ui row_menu_copy_weblink w=176 h=36
assert_ui row_menu_copy_deeplink w=176 h=36
assert_ui row_menu_copy_id w=176 h=36
assert_ui row_menu_open_web w=176 h=36
assert_ui row_menu_export_clipboard w=176 h=36
assert_ui row_menu_divider_export w=176 h=9
assert_ui row_menu_pin w=176 h=36
assert_ui row_menu_mute w=176 h=36
assert_ui row_menu_snooze w=176 h=36
assert_ui row_menu_move_space w=176 h=36
assert_ui row_menu_move_folder w=176 h=36
assert_ui row_menu_archive w=176 h=36

# No submenu on this menu any more: Open, Open & Pin and Open in Split are
# flat rows, as the reference draws them.
expect_no_ui row_menu_open_submenu

key ESCAPE
wait_frames 6
expect_no_text "CONVERSATION"
