# Pins read back from the web (Knots kt-if8e, the read-back half; the
# reference's SessionOverlayPins): a thread pinned in the web app shows as
# pinned here, in the web's arranged order -- pins it never arranged FIRST,
# then the arranged ones in list order (the web's own rule, so both clients
# agree).
#
# settings: {"window_width":1100,"window_height":760,"open_tabs":[],"active_tab":"","theme":"dark"}
# env: HANABI_MOCK_WEB_PINS=t3,t5,t7 HANABI_MOCK_WEB_PIN_ORDER=t7,t3

wait_frames 30
expect_starred t3 yes
expect_starred t5 yes
expect_starred t7 yes
expect_text "PINNED"
expect_row_order pinned t5,t7,t3
