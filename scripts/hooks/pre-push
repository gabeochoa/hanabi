#!/usr/bin/env bash
# Pre-push gate. Installed by `make install-hooks` (never active just by being
# in the repo — a hook has to be copied into the hooks dir to run).
#
# Runs `make gate`: the test suites and the screenshot baselines. It takes
# several minutes, because it captures and compares 30 screens. To push without
# it once:
#
#     git push --no-verify
#
# There is no CI behind this. If the gate does not run here, nothing runs it.
set -u

ROOT="$(git rev-parse --show-toplevel)"
echo "pre-push: running 'make gate' in $ROOT (this takes a few minutes)"
if make -C "$ROOT" gate; then
    exit 0
fi
echo "pre-push: the gate failed, so the push is stopped." >&2
echo "          Screenshot evidence, if any: $ROOT/test-failures/" >&2
echo "          Push anyway with: git push --no-verify" >&2
exit 1
