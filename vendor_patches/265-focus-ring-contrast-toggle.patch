From 43cf612f647dd6035f4d9379ab58ac92783042c1 Mon Sep 17 00:00:00 2001
From: Hanabi proof patch <gabeochoa@users.noreply.github.com>
Date: Thu, 27 Aug 2026 22:14:03 -0400
Subject: [PATCH] feat(ui): allow focus rings without contrast edges

Pinned base: 9ff9079556c86d0fffb7bbc11c17898a74961c26

Add an independent focus_ring_contrast theme switch. It defaults on for byte-compatible rendering and gates the inner and outer contrast outlines in both immediate and batched renderers.
---
diff --git a/src/plugins/ui/rendering.h b/src/plugins/ui/rendering.h
index 3407ff1..89c93c2 100644
--- a/src/plugins/ui/rendering.h
+++ b/src/plugins/ui/rendering.h
@@ -1623,13 +1623,15 @@ struct RenderImm : System<UIContext<InputAction>, FontManager> {
     // over it (focus_rect sits inside draw_rect).
     if (auto ring = detail::focus_ring_for(context, entity, cmp,
                                            scroll_offset)) {
-      draw_rectangle_rounded_lines(ring->outer_contrast(),
-                                   ring->roundness_at(ring->thickness),
-                                   ring->segments, ring->contrast,
-                                   ring->corners);
-      draw_rectangle_rounded_lines(ring->inner_contrast(),
-                                   ring->roundness_at(-1.f), ring->segments,
-                                   ring->contrast, ring->corners);
+      if (context.theme.focus_ring_contrast) {
+        draw_rectangle_rounded_lines(ring->outer_contrast(),
+                                     ring->roundness_at(ring->thickness),
+                                     ring->segments, ring->contrast,
+                                     ring->corners);
+        draw_rectangle_rounded_lines(ring->inner_contrast(),
+                                     ring->roundness_at(-1.f), ring->segments,
+                                     ring->contrast, ring->corners);
+      }
       for (float t = 0; t < ring->thickness; t += 1.0f)
         draw_rectangle_rounded_lines(ring->expanded(t), ring->roundness_at(t),
                                      ring->segments, ring->color,
@@ -2197,13 +2199,15 @@ struct RenderBatched : System<UIContext<InputAction>, FontManager> {
     // renders in insertion order, so a higher layer here would buy nothing.
     if (auto ring = detail::focus_ring_for(context, entity, cmp,
                                            scroll_offset)) {
-      buffer.add_rounded_rectangle_outline(
-          ring->outer_contrast(), ring->contrast,
-          ring->roundness_at(ring->thickness), ring->segments, ring->corners,
-          layer, entity.id);
-      buffer.add_rounded_rectangle_outline(
-          ring->inner_contrast(), ring->contrast, ring->roundness_at(-1.f),
-          ring->segments, ring->corners, layer, entity.id);
+      if (context.theme.focus_ring_contrast) {
+        buffer.add_rounded_rectangle_outline(
+            ring->outer_contrast(), ring->contrast,
+            ring->roundness_at(ring->thickness), ring->segments, ring->corners,
+            layer, entity.id);
+        buffer.add_rounded_rectangle_outline(
+            ring->inner_contrast(), ring->contrast, ring->roundness_at(-1.f),
+            ring->segments, ring->corners, layer, entity.id);
+      }
       buffer.add_rounded_rectangle_outline(
           ring->rect, ring->color, ring->roundness, ring->segments,
           ring->corners, layer, entity.id, ring->thickness);
diff --git a/src/plugins/ui/theme.h b/src/plugins/ui/theme.h
index 26ce774..391434b 100644
--- a/src/plugins/ui/theme.h
+++ b/src/plugins/ui/theme.h
@@ -273,6 +273,7 @@ struct Theme {
   bool arrows_tab = true;
   float focus_ring_thickness =
       3.0f; // Thickness of focus ring outline (2-3px for visibility)
+  bool focus_ring_contrast = true;
   float focus_ring_offset =
       4.0f; // Distance from element edge to focus ring. Positive insets (ring
             // inside bounds); negative outsets, for a halo around small
-- 
