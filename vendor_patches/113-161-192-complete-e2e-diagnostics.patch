From 7ef29f8aa7090a9a8c9a8c710660433141ac17af Mon Sep 17 00:00:00 2001
From: Hanabi proof patch <gabeochoa@users.noreply.github.com>
Date: Thu, 27 Aug 2026 22:13:22 -0400
Subject: [PATCH] fix(e2e): expose complete failure diagnostics

Pinned base: 428047e3c92442e0ded3a0d473315e9636a451ac

Register the existing dump_ui handler, include the first command argument in generic timeout errors, and retain the full visible-text registry in expect_text failures.
---
 src/plugins/e2e_testing/command_handlers.h | 9 ++++++---
 src/plugins/e2e_testing/ui_commands.h      | 1 +
 2 files changed, 7 insertions(+), 3 deletions(-)

diff --git a/src/plugins/e2e_testing/command_handlers.h b/src/plugins/e2e_testing/command_handlers.h
index 97b8d21..2c9d8ee 100644
--- a/src/plugins/e2e_testing/command_handlers.h
+++ b/src/plugins/e2e_testing/command_handlers.h
@@ -814,13 +814,16 @@ struct E2ECommandCleanupSystem : System<PendingE2ECommand> {
                 // Provide more helpful error for expect_text timeout
                 auto &registry = VisibleTextRegistry::instance();
                 error_msg = std::format(
-                    "Text not found: '{}'. Visible: {:.200}", cmd.args[0],
+                    "Text not found: '{}'. Visible: {}", cmd.args[0],
                     registry.get_all().empty() ? "(empty)"
                                                : registry.get_all());
             } else {
+                const std::string subject =
+                    cmd.args.empty() ? "" : std::format(" ('{}')", cmd.args[0]);
                 error_msg =
-                    std::format("Command '{}' timed out after {} frames",
-                                cmd.name, PendingE2ECommand::MAX_FRAMES);
+                    std::format("Command '{}'{} timed out after {} frames",
+                                cmd.name, subject,
+                                PendingE2ECommand::MAX_FRAMES);
             }
             cmd.fail(error_msg);
             detail::command_error_count()++;
diff --git a/src/plugins/e2e_testing/ui_commands.h b/src/plugins/e2e_testing/ui_commands.h
index af31004..653a614 100644
--- a/src/plugins/e2e_testing/ui_commands.h
+++ b/src/plugins/e2e_testing/ui_commands.h
@@ -1251,6 +1251,7 @@ template <typename InputAction> void register_ui_commands(SystemManager &sm) {
   // UI property assertions
   sm.register_update_system(std::make_unique<HandleAssertUICommand>());
   sm.register_update_system(std::make_unique<HandleAssertUITextCommand>());
+  sm.register_update_system(std::make_unique<HandleDumpUICommand>());
 }
 
 } // namespace ui_commands
